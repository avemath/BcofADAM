---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Social share image, relative to /public (e.g. '/images/share.jpg'). */
  image?: string;
}

const { title, description = site.description, image = '/images/share-card.png' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.launchReady && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#083349" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      !site.launchReady && (
        <div class="preview-ribbon" role="note">
          Preview site — content is still being written by the family.
        </div>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="water-level" aria-hidden="true"><span></span></div>

    <script>
      // Fade sections in as they scroll into view.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // The "water level" on the left edge rises as you scroll the page.
      const level = document.querySelector<HTMLElement>('.water-level span');
      if (level) {
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          const pct = max > 0 ? Math.min(1, scrollY / max) : 0;
          level.style.transform = `scaleY(${pct})`;
        };
        addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      }
    </script>

    <style>
      .preview-ribbon {
        background: var(--sun);
        color: var(--abyss);
        text-align: center;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 6px 16px;
      }
      .water-level {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: 5px;
        z-index: 40;
        background: rgb(8 51 73 / 0.08);
        pointer-events: none;
      }
      .water-level span {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--deep), var(--aqua));
        transform-origin: bottom;
        transform: scaleY(0);
      }
    </style>
  </body>
</html>
