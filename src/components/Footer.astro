---
import Logo from './Logo.astro';
import Wave from './Wave.astro';
import NewsletterForm from './NewsletterForm.astro';
import { site, nav, footerNav, nonprofitLine } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();

// Every page, in three lists, so nothing depends on the header's dropdowns (which need JavaScript).
const byHref = (href: string) => nav.find((item) => item.href === href);
const columns = [
  { title: 'Water safety', links: byHref('/water-safety')?.children ?? [] },
  {
    title: 'Adam and our family',
    links: [
      { label: 'Adam’s story', href: '/adams-story' },
      { label: 'Survivors & families', href: '/survivors-and-families' },
      { label: 'ISR swim lessons', href: '/swim-lessons' },
      ...(byHref('/about')?.children ?? []),
    ],
  },
  { title: 'Get involved', links: byHref('/get-involved')?.children ?? [] },
];
---

<footer class="site-footer">
  <Wave color="var(--abyss)" />
  <div class="site-footer__body">
    <div class="wrap">
      <div class="emergency">
        <strong>If a child is missing, check the water first.</strong>
        Every second counts. Call 911 and start CPR if you’re trained.
      </div>

      <div class="site-footer__brand">
        <Logo light loading="lazy" />
        <p class="site-footer__tag">{site.tagline}</p>
      </div>

      <div class="site-footer__grid">
        {
          columns.map((col) => (
            <nav aria-label={`Footer: ${col.title}`}>
              <h2 class="site-footer__heading">{col.title}</h2>
              <ul>
                {col.links.map((item) => (
                  <li>
                    <a href={url(item.href)}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }

        <div>
          <h2 class="site-footer__heading">Adam’s village</h2>
          {
            site.newsletterFormAction.trim() || site.newsletterUrl.trim() ? (
              <p>A few emails a year with water safety reminders, news about Adam and upcoming events.</p>
            ) : (
              <p>Our mom has written to Adam’s village on Facebook since the week he drowned. Follow along for his milestones, our events and water safety reminders before the holidays.</p>
            )
          }
          {
            site.newsletterFormAction.trim() ? (
              <NewsletterForm dark />
            ) : site.newsletterUrl.trim() ? (
              <a class="btn" href={site.newsletterUrl} rel="noopener" target="_blank">
                Sign up for emails
              </a>
            ) : (
              site.facebookUrl && (
                <a class="btn" href={site.facebookUrl} rel="noopener" target="_blank">
                  Follow on Facebook
                </a>
              )
            )
          }
        </div>
      </div>

      <div class="site-footer__legal">
        <p>
          © {year} {site.name}{site.location && ` · ${site.location}`}
          {footerNav
            .filter((item) => ['/privacy', '/terms', '/accessibility'].includes(item.href))
            .map((item) => (
              <>
                {' · '}
                <a href={url(item.href)}>{item.label}</a>
              </>
            ))}
        </p>
        {nonprofitLine && <p>{nonprofitLine}</p>}
        <p>
          The information on this site is for education and awareness and is not a substitute for
          professional medical advice.
        </p>
        <p>
          This website was made by Avery Matherne, Adam’s sister, and she keeps it running. Spotted a bug, a typo or
          a broken link? <a href={`mailto:${site.email}?subject=${encodeURIComponent('Website bug')}`}>Tell us</a> and
          we’ll sort it out as soon as we can.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    color: var(--on-dark-soft);
  }
  .site-footer__body {
    background: var(--abyss);
    padding: 32px 0 40px;
  }
  .emergency {
    background: rgb(255 183 3 / 0.12);
    border: 1px solid rgb(255 183 3 / 0.4);
    color: #fff;
    border-radius: var(--radius);
    padding: 18px 22px;
    margin-bottom: 48px;
  }
  .emergency strong {
    color: var(--sun);
    margin-right: 0.35em;
  }
  .site-footer__grid {
    display: grid;
    gap: 36px 24px;
  }
  /* On phones the two link lists share a row, so the footer is half as tall. */
  .site-footer__brand {
    margin-bottom: 28px;
  }
  @media (max-width: 759px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__grid > :last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 760px) and (max-width: 999px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .site-footer__grid > :last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1000px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1.1fr 1fr 1.4fr;
    }
  }
  .site-footer__tag {
    margin-top: 12px;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--on-dark);
  }
  .site-footer__heading {
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun);
    margin-bottom: 1rem;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer li {
    margin: 0;
  }
  .site-footer a:not(.btn) {
    color: var(--on-dark);
    text-decoration: none;
  }
  /* Each footer link is a comfortable thumb-sized row on phones. */
  .site-footer li > a:not(.btn) {
    display: inline-block;
    padding: 8px 0;
  }
  .site-footer a:not(.btn):hover {
    color: var(--sun);
    text-decoration: underline;
  }
  .site-footer .site-footer__legal a:not(.btn) {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.5);
    text-underline-offset: 3px;
  }
  .site-footer__legal {
    border-top: 1px solid rgb(255 255 255 / 0.1);
    margin-top: 48px;
    padding-top: 24px;
    font-size: 0.875rem;
  }
  .site-footer__legal p {
    margin-bottom: 0.4em;
  }
</style>
