---
import type { CollectionEntry } from 'astro:content';
import { url, href } from '../lib/url';
import { eventDate, eventEnd, isHappening, today } from '../lib/events';
import { prose } from '../lib/prose';

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const e = event.data;
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const monthDay = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const monthYear = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const start = eventDate(event);
const end = eventEnd(event);
const multiDay = !!start && !!end && end > start;
const range = (from: Date, to: Date) => (multiDay ? fmt.formatRange(from, to) : fmt.format(from));
// Yearly events read "Every June 5 · Next: June 5, 2027". A whole-month event ("Every May", with a last day)
// reads "Every May · Next: May 2027", or "Happening now" while it's on. One-time events show their date
// (or dates), plus any time written in "When", like "1 to 5 p.m.".
const wholeMonth = !!e.when && !/\d/.test(e.when);
let when = e.when;
if (e.repeatsYearly && start && end) {
  const every = e.when || `Every ${monthDay.format(start)}`;
  const next = wholeMonth ? monthYear.format(start) : range(start, end);
  when = `${every} · ${isHappening(event) ? 'Happening now' : `Next: ${next}`}`;
} else if (e.date && start && end) {
  when = [range(start, end), e.when].filter(Boolean).join(' · ');
}
// Upcoming events get an "Add to calendar" file (src/pages/events/[id].ics.ts).
const upcoming = !!end && end >= today();
// "More about the event" from the Studio, tucked under a "More" toggle.
const more = event.body?.trim() ? prose(event.rendered?.html) : '';
const icon: Record<string, string> = {
  Fundraiser: '🎉',
  Awareness: '💙',
  'Swim & safety': '🏊',
  Community: '🤝',
};
// A few friendly icons picked from the event name.
const t = e.title.toLowerCase();
const art = /fish|rodeo/.test(t)
  ? '🎣'
  : /cornhole/.test(t)
    ? '🎯'
    : /mardi gras/.test(t)
      ? '🎭'
      : /booth|tent/.test(t)
        ? '⛺'
        : (icon[e.kind] ?? '💙');
---

<article class="event card">
  {
    e.photo ? (
      <img class:list={['event__photo', { 'event__photo--whole': e.photoWhole }]} sizes="(min-width: 1000px) 380px, (min-width: 700px) 50vw, 100vw" src={url(e.photo)} alt={e.photoAlt || e.title} data-missing-alt={!e.photoAlt || undefined} loading="lazy" />
    ) : (
      <div class="event__art" aria-hidden="true">
        <span>{art}</span>
      </div>
    )
  }
  <div class="event__body">
    <p class="event__meta">
      <span class="event__kind">{e.kind}</span>
      {when && <span>{when}</span>}
    </p>
    <h3>{e.title}</h3>
    {e.location && <p class="event__where">{e.location}</p>}
    {e.summary && <p>{e.summary}</p>}
    {e.highlight && <p class="event__highlight">{e.highlight}</p>}
    {
      more && (
        <details class="event__more">
          <summary>More about this event</summary>
          <div class="prose" set:html={more} />
        </details>
      )
    }
    {
      upcoming && (
        <a class="event__cal" href={url(`/events/${event.id}.ics`)} download={`${event.id}.ics`}>
          Add to my calendar<span class="visually-hidden">: {e.title}</span>
        </a>
      )
    }
    {
      e.link && (
        <a class="btn btn--ocean event__btn" href={href(e.link)} rel="noopener">
          {e.linkLabel || 'Learn more'}
          <span class="visually-hidden"> about {e.title}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .event {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .event__photo,
  .event__art {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* On phones, events without a photo get a short band of color, not a photo-sized block of nothing. */
  @media (max-width: 759px) {
    .event__art {
      aspect-ratio: 5 / 2;
    }
  }
  .event__photo {
    object-position: center 55%;
  }
  /* Flyers and wide pictures: show all of it on the card's blue background. */
  .event__photo--whole {
    object-fit: contain;
    object-position: center;
    background: linear-gradient(160deg, var(--ocean-bright), var(--deep));
  }
  .event__art {
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 80% at 80% 0%, rgb(255 214 120 / 0.55), transparent 70%),
      linear-gradient(160deg, var(--ocean-bright), var(--deep));
    font-size: 3.2rem;
  }
  .event__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .event__kind {
    color: var(--aqua-text);
  }
  .event h3 {
    font-size: 1.45rem;
    margin-bottom: 0.3em;
  }
  .event__where {
    font-weight: 600;
    color: var(--ocean);
    margin-bottom: 0.6em;
  }
  .event__highlight {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ocean);
  }
  .event__more {
    margin-bottom: 1rem;
  }
  .event__more summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ocean);
    min-height: 24px;
  }
  .event__more .prose {
    margin-top: 0.6em;
    font-size: 0.95rem;
  }
  .event__cal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    margin: 0 0 1rem;
    font-weight: 700;
    align-self: flex-start;
  }
  .event__cal::before {
    content: '📅';
    text-decoration: none;
  }
  .event__btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
