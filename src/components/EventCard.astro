---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { eventDate } from '../lib/events';

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const e = event.data;
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const monthYear = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const next = eventDate(event);
// Yearly events read "Every June 5 · Next: June 5, 2027" (or "Every May · Next: May 2027"
// for a whole month); one-time events show their date.
const nextLabel = next && (/\d/.test(e.when ?? '') ? fmt.format(next) : monthYear.format(next));
const when = e.repeatsYearly && next ? `${e.when || 'Every year'} · Next: ${nextLabel}` : e.date ? fmt.format(e.date) : e.when;
const icon: Record<string, string> = {
  Fundraiser: '🎉',
  Awareness: '💙',
  'Swim & safety': '🏊',
  Community: '🤝',
};
// A few friendly icons picked from the event name.
const t = e.title.toLowerCase();
const art = /fish|rodeo/.test(t)
  ? '🎣'
  : /cornhole/.test(t)
    ? '🎯'
    : /mardi gras/.test(t)
      ? '🎭'
      : /booth|tent/.test(t)
        ? '⛺'
        : (icon[e.kind] ?? '💙');
---

<article class="event card">
  {
    e.photo ? (
      <img class:list={['event__photo', { 'event__photo--whole': e.photoWhole }]} sizes="(min-width: 1000px) 380px, (min-width: 700px) 50vw, 100vw" src={url(e.photo)} alt={e.photoAlt || e.title} data-missing-alt={!e.photoAlt || undefined} loading="lazy" />
    ) : (
      <div class="event__art" aria-hidden="true">
        <span>{art}</span>
      </div>
    )
  }
  <div class="event__body">
    <p class="event__meta">
      <span class="event__kind">{e.kind}</span>
      {when && <span>{when}</span>}
    </p>
    <h3>{e.title}</h3>
    {e.location && <p class="event__where">{e.location}</p>}
    {e.summary && <p>{e.summary}</p>}
    {e.highlight && <p class="event__highlight">{e.highlight}</p>}
    {
      e.link && (
        <a class="btn btn--ocean event__btn" href={url(e.link)} rel="noopener">
          {e.linkLabel || 'Learn more'}
          <span class="visually-hidden"> about {e.title}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .event {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .event__photo,
  .event__art {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .event__photo {
    object-position: center 55%;
  }
  /* Flyers and wide pictures: show all of it on the card's blue background. */
  .event__photo--whole {
    object-fit: contain;
    object-position: center;
    background: linear-gradient(160deg, var(--ocean-bright), var(--deep));
  }
  .event__art {
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 80% at 80% 0%, rgb(255 214 120 / 0.55), transparent 70%),
      linear-gradient(160deg, var(--ocean-bright), var(--deep));
    font-size: 3.2rem;
  }
  .event__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .event__kind {
    color: var(--aqua-text);
  }
  .event h3 {
    font-size: 1.45rem;
    margin-bottom: 0.3em;
  }
  .event__where {
    font-weight: 600;
    color: var(--ocean);
    margin-bottom: 0.6em;
  }
  .event__highlight {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ocean);
  }
  .event__btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
