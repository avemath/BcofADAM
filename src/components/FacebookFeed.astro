---
/**
 * Our Facebook page's latest posts, using Facebook's official Page Plugin.
 * Turn it on or off in the Studio (Site settings → Show Facebook feed).
 *
 * Facebook only loads when a visitor clicks "Show our latest posts", so nobody
 * gets Facebook's cookies or trackers just for visiting our site. Until then
 * it's a simple card with a link to the page.
 *
 * Facebook won't draw the feed wider than 500px, so on bigger screens we
 * scale it up to fill its space (up to 1.5×). On phones it shrinks to fit.
 * The height follows the screen too, up to `maxHeight`.
 */
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  maxHeight?: number;
}
const { maxHeight = 900 } = Astro.props;

const pageUrl = site.facebookUrl;
const title = 'Latest posts from the Because of ADAM Facebook page';

---

{
  site.showFacebookFeed && pageUrl && (
    <div class="fb-feed" data-fb-feed data-href={pageUrl} style={`--max-h:${maxHeight}px`}>
      <div class="fb-feed__frame" data-fb-frame hidden>
        <iframe data-fb-iframe title={title} allow="encrypted-media; picture-in-picture; web-share" />
      </div>
      <div class="fb-feed__card card" data-fb-card>
        <img class="fb-feed__logo" src={url('/images/logo-mark.png')} alt="" width="54" height="64" />
        <div>
          <p class="fb-feed__name">{site.name} on Facebook</p>
          <p class="fb-feed__note">
            Updates on Adam, events and water safety reminders. Showing the posts here loads content from
            Facebook, which may set its own cookies.
          </p>
          <div class="fb-feed__actions">
            <button class="btn btn--ocean" type="button" data-fb-load hidden>
              Show our latest posts
            </button>
            <a class="btn btn--ghost" href={pageUrl} rel="noopener" target="_blank">
              Open our Facebook page<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  )
}

<script>
  const FB_MAX_WIDTH = 500; // the widest Facebook will draw the feed
  const FB_MIN_WIDTH = 180; // the narrowest

  function fit(feed: HTMLElement) {
    const frame = feed.querySelector<HTMLElement>('.fb-feed__frame');
    const iframe = feed.querySelector<HTMLIFrameElement>('[data-fb-iframe]');
    if (!frame || !iframe) return;

    // How much room the feed has on this screen (set by the CSS below).
    const boxW = frame.clientWidth;
    const boxH = frame.clientHeight;
    if (!boxW || !boxH) return;

    const width = Math.max(FB_MIN_WIDTH, Math.min(FB_MAX_WIDTH, Math.floor(boxW)));
    const scale = boxW > FB_MAX_WIDTH ? boxW / FB_MAX_WIDTH : 1;
    // Round the height so small changes don't reload the feed.
    const height = Math.round(boxH / scale / 10) * 10;

    iframe.style.width = `${width}px`;
    iframe.style.height = `${height}px`;
    iframe.style.transform = scale > 1 ? `scale(${scale})` : '';

    // Only reload the feed when Facebook needs to redraw it at a new size.
    const size = `${width}x${height}`;
    if (iframe.dataset.size === size) return;
    iframe.dataset.size = size;
    iframe.src =
      'https://www.facebook.com/plugins/page.php?' +
      new URLSearchParams({
        href: feed.dataset.href ?? '',
        tabs: 'timeline',
        width: String(width),
        height: String(height),
        small_header: 'false',
        adapt_container_width: 'true',
        hide_cover: 'false',
        show_facepile: 'false',
      }).toString();
  }

  const feeds: HTMLElement[] = [];
  document.querySelectorAll<HTMLElement>('[data-fb-feed]').forEach((feed) => {
    const button = feed.querySelector<HTMLButtonElement>('[data-fb-load]');
    if (!button) return;
    button.hidden = false; // the button only works with JavaScript
    button.addEventListener('click', () => {
      feed.querySelector<HTMLElement>('[data-fb-frame]')?.removeAttribute('hidden');
      feed.querySelector<HTMLElement>('[data-fb-card]')?.setAttribute('hidden', '');
      feeds.push(feed);
      fit(feed);
      feed.querySelector<HTMLIFrameElement>('[data-fb-iframe]')?.focus();
    });
  });

  // Refit when the window is resized or the phone is turned sideways, once it settles.
  // (The height uses svh, so a phone's address bar sliding away doesn't reload the feed.)
  let timer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => feeds.forEach(fit), 300);
  });
</script>

<style>
  .fb-feed {
    width: 100%;
    /* 500px is Facebook's widest; we scale it up to 1.5× on big screens. */
    max-width: 750px;
  }
  .fb-feed__frame {
    position: relative;
    width: 100%;
    /* Most of the screen's height, but never tiny and never taller than maxHeight. */
    height: clamp(480px, 80vh, var(--max-h));
    height: clamp(480px, 80svh, var(--max-h));
    border-radius: var(--radius);
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.7)),
      var(--foam);
    box-shadow: var(--shadow);
  }
  .fb-feed__frame::before {
    content: 'Loading our latest posts…';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .fb-feed iframe {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    transform-origin: 0 0;
  }
  .fb-feed__frame[hidden],
  .fb-feed__card[hidden] {
    display: none;
  }
  .fb-feed__card {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .fb-feed__logo {
    flex: none;
    width: 54px;
    height: 64px;
  }
  .fb-feed__name {
    font-weight: 800;
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .fb-feed__note {
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .fb-feed__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 480px) {
    .fb-feed__card {
      flex-direction: column;
    }
  }
</style>
