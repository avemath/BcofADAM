---
/**
 * Our logo: the brain-and-heart mark next to "Because of ADAM".
 * The mark lives in public/images/logo-mark.png (full size: logo-mark-large.png).
 */
import { url } from '../lib/url';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]}>
  <img class="logo__mark" src={url('/images/logo-mark.png')} alt="" width="40" height="48" />
  <span class="logo__text">
    <span class="logo__small">Because of</span>
    <span class="logo__big">ADAM</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--deep);
    line-height: 1;
  }
  .logo--light {
    color: #fff;
  }
  .logo__mark {
    width: auto;
    height: 46px;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
  }
  .logo__small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .logo__big {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
</style>
