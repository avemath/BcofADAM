---
/**
 * Shows a photo if one is set. If not, it shows a soft illustration, plus a
 * reminder while the site is still in preview mode.
 */
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  hint?: string;
  ratio?: string;
}
const { src, alt = '', caption, hint = 'Add a photo', ratio = '4 / 5' } = Astro.props;
// Unique ids so several placeholders can share a page.
const uid = Math.random().toString(36).slice(2, 8);
---

<figure class="photo" style={`--ratio:${ratio}`}>
  {
    src ? (
      <img src={url(src)} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="photo__placeholder" role="img" aria-label="Illustration of sunlight on water">
        <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id={`sky-${uid}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff4d6" />
              <stop offset="1" stop-color="#bfe7ea" />
            </linearGradient>
            <linearGradient id={`sea-${uid}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1aa6b7" />
              <stop offset="1" stop-color="#083349" />
            </linearGradient>
          </defs>
          <rect width="400" height="500" fill={`url(#sky-${uid})`} />
          <circle cx="200" cy="200" r="70" fill="#ffb703" opacity="0.9" />
          <rect y="240" width="400" height="260" fill={`url(#sea-${uid})`} />
          <path d="M0 250 q 50 -18 100 0 t 100 0 t 100 0 t 100 0 V270 H0 Z" fill="#bfe7ea" opacity="0.5" />
          <path d="M60 300 h80 M230 320 h110 M120 360 h90 M260 390 h60" stroke="#fff" stroke-opacity="0.35" stroke-width="4" stroke-linecap="round" />
        </svg>
        {!site.launchReady && <span class="photo__hint">{hint}</span>}
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }
  .photo img,
  .photo__placeholder {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgb(4 29 43 / 0.55);
  }
  .photo__placeholder {
    position: relative;
    overflow: hidden;
  }
  .photo__placeholder svg {
    width: 100%;
    height: 100%;
  }
  .photo__hint {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: rgb(255 255 255 / 0.9);
    color: var(--deep);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: 10px;
  }
</style>
