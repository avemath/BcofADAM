---
/**
 * Counts how long the visitor has been on the page and sets it beside a
 * moment from Adam's story. The words come from src/data/home.json (editable in the Studio).
 */
import { home as story } from '../data/content';
---

<div class="clock" data-clock>
  <p class="visually-hidden">A timer here counts how long you’ve been reading this page.</p>
  <p class="clock__label" aria-hidden="true">You’ve been on this page for</p>
  <p class="clock__time" aria-hidden="true"><span data-clock-time>0:00</span></p>
  <p class="clock__compare">{story.timeCompare}</p>
  <p class="clock__quote">“{story.familyQuote}”</p>
  <p class="clock__cite">{story.familyQuoteBy}</p>
  <p class="clock__hope">{story.hopeTurn}</p>
</div>

<script>
  // The clock is hidden from screen readers (the sentence above describes it), so
  // it isn't read out every second. With reduced motion on, it shows whole minutes
  // and changes once a minute instead of every second.
  const start = performance.now();
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-clock-time]').forEach((el) => {
    // "under 1 min" is longer than "0:07", so it gets a smaller size to stay on one line.
    el.parentElement?.classList.toggle('clock__time--calm', calm);
    const tick = () => {
      const s = Math.floor((performance.now() - start) / 1000);
      const m = Math.floor(s / 60);
      el.textContent = calm
        ? m < 1
          ? 'under 1 min'
          : `${m} min`
        : `${m}:${String(s % 60).padStart(2, '0')}`;
    };
    tick();
    setInterval(tick, calm ? 15000 : 1000);
  });
</script>

<style>
  .clock {
    text-align: center;
  }
  .clock__label {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--on-dark-soft);
    margin-bottom: 0;
  }
  .clock__time {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: clamp(5rem, 16vw, 11rem);
    line-height: 1;
    font-weight: 300;
    color: #fff;
    margin: 0.1em 0 0.2em;
    text-shadow: 0 0 60px rgb(26 166 183 / 0.6);
  }
  .clock__time--calm {
    font-size: clamp(3rem, 10vw, 6.5rem);
    white-space: nowrap;
  }
  .clock__compare {
    font-size: clamp(1.2rem, 1vw + 1rem, 1.6rem);
    max-width: 34ch;
    margin-inline: auto;
    color: var(--on-dark);
  }
  .clock__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 2.4vw + 1rem, 2.6rem);
    color: var(--sun);
    margin: 1.2em 0 0.2em;
  }
  .clock__cite {
    font-size: 0.9rem;
    color: var(--on-dark-soft);
  }
  .clock__hope {
    font-size: clamp(1.15rem, 0.8vw + 1rem, 1.45rem);
    font-weight: 600;
    color: #fff;
    max-width: 34ch;
    margin: 2em auto 0;
    padding-top: 1.5em;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
</style>
