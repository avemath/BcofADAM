---
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<section class="cta-band">
  <div class="wrap cta-band__inner reveal">
    <div>
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="cta-band__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(255 255 255 / 0.35), transparent 60%),
      var(--sun);
    color: var(--abyss);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .cta-band__inner {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1.5fr 1fr;
    }
    .cta-band__actions {
      justify-self: end;
    }
  }
  .cta-band h2 {
    margin-bottom: 0.3em;
  }
  .cta-band p {
    font-size: 1.15rem;
    margin: 0;
    max-width: 55ch;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta-band :global(.btn) {
    --btn-bg: var(--abyss);
    --btn-fg: #fff;
  }
  .cta-band :global(.btn--ghost) {
    --btn-bg: transparent;
    --btn-fg: var(--abyss);
  }
</style>
