---
import Logo from './Logo.astro';
import { nav, hasDonate } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => !href.includes('#') && current === url(href).replace(/\/$/, '');
const slug = (label: string) => label.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={url('/')} class="site-header__brand" aria-label="Because of ADAM, home">
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="menu-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          nav.map((item) => {
            const inSection = isCurrent(item.href) || !!item.children?.some((c) => isCurrent(c.href));
            const menuId = `menu-${slug(item.label)}`;
            return (
              <li class:list={['site-nav__item', { 'has-menu': item.children, 'is-section': inSection }]}>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.children && (
                  <>
                    <button
                      class="submenu-toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={menuId}
                      data-submenu-toggle
                    >
                      <span class="visually-hidden">More in {item.label}</span>
                      <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
                        <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <ul class="submenu" id={menuId}>
                      {item.children.map((c) => (
                        <li>
                          <a href={url(c.href)} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                            {c.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
      {hasDonate && <a href={url('/donate')} class="btn site-nav__donate">Donate</a>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  const subToggles = [...document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]')];

  const setSub = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.closest('.site-nav__item')?.classList.toggle('is-open', open);
  };
  const closeSubs = (except?: HTMLButtonElement) => subToggles.forEach((b) => b !== except && setSub(b, false));

  // Main menu button (phones and tablets). While it's open, the page behind it doesn't scroll.
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    navEl?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };
  const menuOpen = () => navEl?.classList.contains('is-open') ?? false;
  toggle?.addEventListener('click', () => setMenu(!menuOpen()));

  // A link to a spot on the same page (like "Volunteer") scrolls there, so close the menu first.
  navEl?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) {
      closeSubs();
      if (menuOpen()) setMenu(false);
    }
  });

  // The little arrows open each section's pages. Only one list is open at a time.
  subToggles.forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeSubs(btn);
      setSub(btn, !open);
    }),
  );

  // Close lists (and the phone menu) when clicking elsewhere or tabbing away.
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Node ? e.target : null;
    if (!target || !navEl?.contains(target)) closeSubs();
    if (menuOpen() && target && !navEl?.contains(target) && !toggle?.contains(target)) setMenu(false);
  });
  navEl?.addEventListener('focusin', (e) => {
    subToggles.forEach((b) => {
      if (e.target instanceof Node && !b.closest('.site-nav__item')?.contains(e.target)) setSub(b, false);
    });
  });
  navEl?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget;
    if (!(next instanceof Node) || !navEl.contains(next)) closeSubs();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openSub = subToggles.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (openSub) {
      setSub(openSub, false);
      openSub.focus();
    } else if (menuOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 238 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid rgb(8 51 73 / 0.08);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .site-header__brand {
    text-decoration: none;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .site-nav a:not(.btn):hover,
  .site-nav a[aria-current='page'] {
    color: var(--ocean);
    text-decoration: underline;
    text-decoration-color: var(--aqua);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }

  .site-nav__item.is-section > a {
    color: var(--ocean);
  }
  .submenu-toggle {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .submenu-toggle:hover {
    background: rgb(8 51 73 / 0.08);
  }
  .submenu-toggle svg {
    transition: transform 0.2s ease;
  }
  .submenu-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .submenu {
    display: none;
  }
  .site-nav__item.is-open > .submenu {
    display: block;
  }
  .submenu a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  /* Without JavaScript the arrows can't open anything, so hide them (every page is also in the footer). */
  :global(html:not(.js)) .submenu-toggle {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px;
    border: 2px solid var(--deep);
    border-radius: 999px;
    background: transparent;
    color: var(--deep);
    font: 700 0.95rem var(--font-body);
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s ease;
  }
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
  }
  .menu-toggle__bars::before {
    top: -6px;
  }
  .menu-toggle__bars::after {
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile: slide-down panel */
  @media (max-width: 1199px) {
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--sand);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      padding: 8px var(--gutter) 24px;
      /* Long menus scroll inside the panel instead of running off the screen. */
      max-height: calc(100vh - 120px);
      max-height: calc(100dvh - 120px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-nav.is-open {
      display: block;
    }
    .site-nav__item {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .site-nav__item > a:not(.btn) {
      flex: 1;
      display: block;
      padding: 14px 0;
      font-size: 1.1rem;
    }
    .submenu-toggle {
      width: 44px;
      height: 44px;
    }
    .site-nav .submenu {
      flex-basis: 100%;
      padding: 0 0 10px 16px;
      border-left: 3px solid var(--aqua);
      margin: 0 0 12px 2px;
    }
    .submenu a:not(.btn) {
      font-size: 1.02rem;
    }
    .site-nav__donate {
      margin-top: 20px;
      width: 100%;
    }
    :global(html.menu-open) {
      overflow: hidden;
    }
    /* Without JavaScript the Menu button can't open anything, so show the menu under the logo. */
    :global(html:not(.js)) .menu-toggle {
      display: none;
    }
    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
    }
    :global(html:not(.js)) .site-nav {
      display: block;
      position: static;
      flex-basis: 100%;
      box-shadow: none;
      border-bottom: 0;
      max-height: none;
      padding: 0 0 16px;
    }
  }

  /* Desktop: inline */
  /* The full menu fits on one line from 1200px up; below that, the Menu button. */
  @media (min-width: 1200px) {
    .menu-toggle {
      display: none;
    }
    .site-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .site-nav__list {
      display: flex;
      gap: 18px;
    }
    .site-nav__item {
      position: relative;
      display: flex;
      align-items: center;
      gap: 2px;
    }
    .site-nav__item > a {
      white-space: nowrap;
    }
    .site-nav .submenu {
      position: absolute;
      top: calc(100% + 14px);
      left: -16px;
      min-width: 250px;
      padding: 8px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow);
    }
    .site-nav__item:last-child .submenu {
      left: auto;
      right: 0;
    }
    .submenu a:not(.btn) {
      padding: 0 12px;
      border-radius: 8px;
      white-space: nowrap;
    }
    .submenu a:not(.btn):hover,
    .submenu a[aria-current='page'] {
      background: var(--foam);
      text-decoration: none;
    }
  }
</style>
