---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import IsrFinder from '../components/IsrFinder.astro';
import PediatriciansSay from '../components/PediatriciansSay.astro';
import { isr } from '../data/content';
import { url } from '../lib/url';
import { prose } from '../lib/prose';

const entry = await getEntry('pages', 'swim-lessons');
if (!entry) throw new Error('Missing src/content/pages/swim-lessons.md');
const html = prose(entry.rendered?.html);
const { title, eyebrow, lede, description, image, imageAlt } = entry.data;
---

<BaseLayout title={title} description={description || lede} image={image || undefined} imageAlt={imageAlt || undefined}>
  <PageHero eyebrow={eyebrow} title={title} lede={lede}>
    <div class="btn-row">
      <a class="btn" href="#find">Find an ISR instructor near you</a>
      <a class="btn btn--ghost" href="#dad">Why our dad teaches ISR</a>
    </div>
  </PageHero>

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap isr-layout">
      <div class="isr-main">
        <PediatriciansSay />
        <article class="prose" set:html={html} />
      </div>

      <aside class="isr-aside">
        <div id="dad" class="program card">
          {isr.photo && <img sizes="(min-width: 1000px) 320px, 100vw" src={url(isr.photo)} alt={isr.photoAlt || 'Our dad teaching an ISR lesson'} data-missing-alt={!isr.photoAlt || undefined} loading="lazy" />}
          <p class="program__label">Our dad teaches ISR</p>
          <h2 class="program__name">{isr.programName}</h2>
          <p>{isr.blurb}</p>
          <p class="program__note">{isr.disclosure}</p>
          <a class="btn" href="#find">Find an instructor near you</a>
        </div>
      </aside>
    </div>
  </section>

  <section id="find" class="section section--deep finder-section">
    <div class="wrap narrow">
      <IsrFinder />
    </div>
  </section>

  <CtaBand
    title="Lessons are one layer. Stack them."
    text="Even the best swim skills never replace an adult watching, a four-sided fence, alarms and CPR."
  >
    <a class="btn" href={url('/water-safety')}>All the layers</a>
    <a class="btn btn--ghost" href={url('/water-watcher')}>Take the pledge</a>
  </CtaBand>
</BaseLayout>

<style>
  .isr-layout {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .isr-layout {
      grid-template-columns: minmax(0, 1fr) 360px;
      align-items: start;
    }
    .isr-aside {
      position: sticky;
      top: 100px;
    }
  }
  .program {
    background:
      radial-gradient(50% 60% at 100% 100%, rgb(255 214 120 / 0.18), transparent 70%),
      linear-gradient(340deg, var(--ocean-bright), var(--ocean));
    color: #fff;
    border: 0;
    scroll-margin-top: 100px;
  }
  .program img {
    width: 100%;
    border-radius: var(--radius-sm);
    margin-bottom: 18px;
  }
  .program__label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sun-text);
    margin-bottom: 4px;
  }
  .program__name {
    font-size: 1.9rem;
    margin-bottom: 0.6em;
  }
  .program__note {
    font-size: 0.85rem;
    color: var(--on-dark);
    border-top: 1px solid rgb(255 255 255 / 0.25);
    padding-top: 14px;
  }
  .isr-main {
    display: grid;
    gap: 40px;
    min-width: 0;
  }
  .finder-section {
    scroll-margin-top: 80px;
  }
</style>
