---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';
import { prose } from '../../lib/prose';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const html = prose(post.rendered?.html);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout title={post.data.title} description={post.data.summary || undefined} type="Article" published={post.data.date}>
  <PageHero eyebrow={fmt.format(post.data.date)} title={post.data.title} lede={post.data.summary} />
  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap">
      <article class="prose">
        <Fragment set:html={html} />
      </article>
      <p style="margin-top: 48px"><a href={url('/news')}>← All news</a></p>
    </div>
  </section>

  {
    post.id.includes('color-of-love') && (
      <CtaBand title="Thank you for reading it." text="If your own family has a June 5, write to us. If you’re here to understand ours, Adam’s story picks up where the poem leaves off.">
        <a class="btn" href={url('/contact')}>Write to us</a>
        <a class="btn btn--ghost" href={url('/adams-story')}>Read Adam’s story</a>
      </CtaBand>
    )
  }
</BaseLayout>
