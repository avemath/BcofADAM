---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';
import FacebookFeed from '../../components/FacebookFeed.astro';
import { site } from '../../data/site';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout title="News & Updates" description="What’s new with Adam and our family, upcoming events and the latest in drowning prevention, from Because of ADAM in Blair County, Pennsylvania.">
  <PageHero eyebrow="News" title="News & updates" lede="What’s new with Adam, with us, and with the fight to end childhood drowning. For the day to day, our Facebook page is where Mom writes." />
  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap news-layout">
      <div>
      {posts.length === 0 && <p>No updates yet. Check back soon.</p>}
      <ul class="posts">
        {
          posts.map((p) => (
            <li class="card">
              <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
              <h2>
                <a href={url(`/news/${p.id}`)}>{p.data.title}</a>
              </h2>
              <p>{p.data.summary}</p>
            </li>
          ))
        }
      </ul>
      </div>
      {
        site.showFacebookFeed && (
          <div class="news-aside">
            <h2 class="news-aside__title">Latest on Facebook</h2>
            <FacebookFeed maxHeight={1000} />
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .news-layout {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .news-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }
  .news-aside__title {
    font-size: 1.4rem;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .posts time {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--aqua-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .posts h2 {
    font-size: 1.6rem;
    margin-top: 6px;
  }
  .posts h2 a {
    text-decoration: none;
    color: var(--ink);
  }
  .posts h2 a:hover {
    color: var(--ocean);
    text-decoration: underline;
  }
</style>
