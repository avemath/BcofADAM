---
/**
 * Water safety quiz with a printable certificate. Questions are edited in the Studio
 * (Pages → Water safety quiz). Nothing people type or pick here leaves their browser.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Logo from '../components/Logo.astro';
import { quiz } from '../data/content';
import { url } from '../lib/url';

const total = quiz.questions.length;
const host = Astro.site?.host ?? 'becauseofadam.org';
---

<BaseLayout
  title="Water Safety Quiz"
  description="Ten quick questions about how drowning really happens and what stops it, with a source for every answer. Finish to print a Water Safety Champion certificate."
>
  <PageHero eyebrow="Water safety quiz" title={quiz.title} lede={quiz.intro} />

  <section class="section quiz-section" style="padding-top: clamp(40px, 6vw, 72px)" data-quiz-section>
    <div class="wrap narrow">
      <p class="quiz__progress" data-progress>{total} questions</p>

      <ol class="quiz" data-quiz>
        {
          quiz.questions.map((q, i) => (
            <li class="quiz__q card" data-q data-answer={q.answer}>
              <fieldset>
                <legend>
                  <span class="quiz__num">
                    Question {i + 1} of {total}
                  </span>
                  <span class="quiz__text">{q.question}</span>
                </legend>
                <div class="quiz__choices">
                  {q.choices.map((c) => (
                    <label class="quiz__choice">
                      <input type="radio" name={`q${i}`} value={c} />
                      <span>{c}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <button type="button" class="btn btn--ocean quiz__check" data-check>
                Check my answer
              </button>
              <p class="quiz__result" role="status" data-result />
              <div class="quiz__explain" data-explain>
                <p>{q.explain}</p>
                <p class="source">
                  Source:{' '}
                  <a href={q.sourceUrl} rel="noopener" target="_blank">
                    {q.source}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </p>
              </div>
              <details class="quiz__answer">
                <summary>See the answer</summary>
                <p>
                  <strong>{q.answer}.</strong> {q.explain}
                </p>
                <p class="source">
                  Source:{' '}
                  <a href={q.sourceUrl} rel="noopener" target="_blank">
                    {q.source}
                  </a>
                </p>
              </details>
            </li>
          ))
        }
      </ol>

      <div class="quiz__done card" data-done hidden>
        <h2 tabindex="-1" data-score>You finished!</h2>
        <p data-score-note></p>
        <div class="field">
          <label for="cert-name">Your name for the certificate</label>
          <input id="cert-name" type="text" autocomplete="name" maxlength="60" data-name />
          <p class="field__hint">It stays on this page. We don’t save it or send it anywhere.</p>
        </div>
        <div class="btn-row">
          <button type="button" class="btn" data-print>Print my certificate</button>
          <button type="button" class="btn btn--ghost" data-share>Share the quiz</button>
          <button type="button" class="btn btn--ghost" data-reset>Take it again</button>
        </div>
        <p class="quiz__share-note" role="status" data-share-note></p>
      </div>

      <div class="certificate" data-certificate hidden>
        <div class="certificate__inner">
          <Logo />
          <p class="certificate__eyebrow">Certificate</p>
          <p class="certificate__title">{quiz.certificateTitle}</p>
          <p class="certificate__name" data-cert-name>Your name</p>
          <p class="certificate__text">{quiz.certificateText}</p>
          <p class="certificate__foot">
            <span data-cert-date></span>
            <span>{host}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Now make it a habit." text="Knowing is the first layer. Name a Water Watcher every time, and share the layers with the people who watch your kids.">
    <a class="btn btn--ocean" href={url('/water-watcher')}>Take the Water Watcher pledge</a>
    <a class="btn btn--ghost" href={url('/water-safety')}>Learn the layers</a>
  </CtaBand>

  <script>
    const section = document.querySelector<HTMLElement>('[data-quiz-section]');
    const questions = [...document.querySelectorAll<HTMLElement>('[data-q]')];
    const progress = document.querySelector<HTMLElement>('[data-progress]');
    const done = document.querySelector<HTMLElement>('[data-done]');
    const certificate = document.querySelector<HTMLElement>('[data-certificate]');
    const scoreHeading = document.querySelector<HTMLElement>('[data-score]');
    const scoreNote = document.querySelector<HTMLElement>('[data-score-note]');
    const nameInput = document.querySelector<HTMLInputElement>('[data-name]');
    const certName = document.querySelector<HTMLElement>('[data-cert-name]');
    const certDate = document.querySelector<HTMLElement>('[data-cert-date]');
    const shareNote = document.querySelector<HTMLElement>('[data-share-note]');
    const total = questions.length;
    let right = 0;
    let answered = 0;

    const updateProgress = () => {
      if (progress) progress.textContent = answered ? `${answered} of ${total} answered · ${right} right` : `${total} questions`;
    };

    const finish = () => {
      if (!done || !certificate) return;
      done.hidden = false;
      certificate.hidden = false;
      section?.classList.add('is-finished');
      if (scoreHeading) scoreHeading.textContent = `You got ${right} of ${total} right.`;
      if (scoreNote) {
        scoreNote.textContent =
          right === total
            ? 'Every single one. Now share it with the people who watch your kids.'
            : 'Look back at the ones you missed. Each has a source you can read. Then share the quiz with the people who watch your kids.';
      }
      if (certDate) certDate.textContent = new Date().toLocaleDateString('en-US', { dateStyle: 'long' });
      scoreHeading?.focus();
    };

    questions.forEach((q) => {
      const check = q.querySelector<HTMLButtonElement>('[data-check]');
      const result = q.querySelector<HTMLElement>('[data-result]');
      check?.addEventListener('click', () => {
        const picked = q.querySelector<HTMLInputElement>('input:checked');
        if (!picked) {
          if (result) result.textContent = 'Pick an answer first.';
          return;
        }
        const answer = q.dataset.answer ?? '';
        const correct = picked.value === answer;
        q.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = true;
          const label = input.closest('label');
          if (input.value === answer) label?.classList.add('is-answer');
          else if (input === picked) label?.classList.add('is-wrong');
        });
        q.classList.add('is-checked', correct ? 'is-right' : 'is-missed');
        if (result) result.textContent = correct ? 'That’s right.' : `Not quite. The answer is: ${answer}.`;
        check.hidden = true;
        // The button just disappeared from under the keyboard, so move focus to the answer.
        if (result) {
          result.tabIndex = -1;
          result.focus({ preventScroll: true });
        }
        answered += 1;
        if (correct) right += 1;
        updateProgress();
        if (answered === total) finish();
      });
    });

    nameInput?.addEventListener('input', () => {
      if (certName) certName.textContent = nameInput.value.trim() || 'Your name';
    });

    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

    document.querySelector('[data-share]')?.addEventListener('click', async () => {
      const data = {
        title: 'How water safe is your family?',
        text: `I got ${right} of ${total} on the Because of ADAM water safety quiz. Take it, then hand it to whoever watches your kids.`,
        url: location.href.split('#')[0],
      };
      try {
        if (navigator.share) {
          await navigator.share(data);
          return;
        }
        await navigator.clipboard.writeText(`${data.text} ${data.url}`);
        if (shareNote) shareNote.textContent = 'Link copied. Paste it anywhere to share.';
      } catch (error) {
        if ((error as DOMException)?.name === 'AbortError') return;
        if (shareNote) shareNote.textContent = `Copy this link to share: ${data.url}`;
      }
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      right = 0;
      answered = 0;
      questions.forEach((q) => {
        q.classList.remove('is-checked', 'is-right', 'is-missed');
        q.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = false;
          input.checked = false;
          input.closest('label')?.classList.remove('is-answer', 'is-wrong');
        });
        const check = q.querySelector<HTMLButtonElement>('[data-check]');
        if (check) check.hidden = false;
        const result = q.querySelector<HTMLElement>('[data-result]');
        if (result) result.textContent = '';
      });
      if (done) done.hidden = true;
      if (certificate) certificate.hidden = true;
      if (shareNote) shareNote.textContent = '';
      section?.classList.remove('is-finished');
      updateProgress();
      questions[0]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      questions[0]?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });
  </script>
</BaseLayout>

<style>
  .quiz {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .quiz__progress {
    font-weight: 700;
    color: var(--ocean);
    margin-bottom: 16px;
  }
  .quiz__q fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .quiz__q legend {
    padding: 0;
    margin-bottom: 14px;
  }
  .quiz__num {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--aqua-text);
    margin-bottom: 4px;
  }
  .quiz__text {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1vw + 1rem, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .quiz__choices {
    display: grid;
    gap: 10px;
  }
  .quiz__choice {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 14px;
    min-height: 48px;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .quiz__choice:hover {
    background: var(--foam);
  }
  .quiz__choice:has(input:checked) {
    border-color: var(--ocean);
    background: var(--foam);
  }
  .quiz__choice input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 2px 0 0;
    accent-color: var(--ocean);
  }
  .quiz__choice:has(input:disabled) {
    cursor: default;
  }
  .quiz__choice.is-answer {
    border-color: #1f7a4d;
    background: #e8f6ee;
  }
  .quiz__choice.is-answer span::after {
    content: '  ✓ Answer';
    font-weight: 700;
    color: #1f6b44;
  }
  .quiz__choice.is-wrong {
    border-color: var(--coral);
    background: #fdeeec;
  }
  .quiz__choice.is-wrong span::after {
    content: '  ✗ Your pick';
    font-weight: 700;
    color: #b3372b;
  }
  .quiz__check {
    display: none;
    margin-top: 16px;
  }
  :global(.js) .quiz__check:not([hidden]) {
    display: inline-flex;
  }
  .quiz__result {
    margin: 14px 0 0;
    font-weight: 700;
  }
  .quiz__result:empty {
    display: none;
  }
  .is-right .quiz__result {
    color: #1f6b44;
  }
  .is-missed .quiz__result {
    color: #b3372b;
  }
  /* With JavaScript, the explanation shows after checking. Without it, "See the answer" does the job. */
  .quiz__explain {
    display: none;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .is-checked .quiz__explain {
    display: block;
  }
  .quiz__explain p:last-child {
    margin-bottom: 0;
  }
  .quiz__answer {
    margin-top: 14px;
  }
  .quiz__answer summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ocean);
  }
  :global(.js) .quiz__answer {
    display: none;
  }
  .quiz__done {
    margin-top: 28px;
    border-top: 6px solid var(--sun);
  }
  .quiz__done h2:focus {
    outline: none;
  }
  .quiz__done .field {
    display: grid;
    gap: 6px;
    margin: 16px 0;
  }
  .quiz__done label {
    font-weight: 700;
  }
  .quiz__done input {
    min-height: 48px;
    padding: 10px 14px;
    font: inherit;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    max-width: 420px;
  }
  .field__hint {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .quiz__share-note {
    margin: 12px 0 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .quiz__share-note:empty {
    display: none;
  }

  /* The certificate: a preview on screen, and the only thing on the page when printed. */
  .certificate {
    margin-top: 28px;
    padding: 10px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--ocean-bright), var(--deep));
  }
  .certificate__inner {
    background: #fff;
    border: 2px solid var(--sun);
    border-radius: calc(var(--radius) - 6px);
    padding: clamp(24px, 5vw, 48px);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .certificate__eyebrow {
    margin: 12px 0 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aqua-text);
  }
  .certificate__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw + 1rem, 2.8rem);
    font-weight: 600;
    color: var(--ocean);
    line-height: 1.1;
  }
  .certificate__name {
    margin: 14px 0 4px;
    min-width: min(100%, 360px);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw + 1rem, 2.1rem);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .certificate__text {
    max-width: 52ch;
    margin: 8px 0 0;
  }
  .certificate__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 24px;
    margin: 16px 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media print {
    :global(.page-hero),
    :global(.cta-band),
    :global(.skip-link) {
      display: none !important;
    }
    :global(main .section) {
      padding: 0 !important;
    }
    .is-finished .quiz,
    .is-finished .quiz__progress,
    .quiz__done {
      display: none !important;
    }
    .certificate {
      margin: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
