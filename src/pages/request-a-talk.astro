---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SiteForm, { type Field } from '../components/SiteForm.astro';

const fields: Field[] = [
  { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
  { name: 'organization', label: 'School, group or organization', required: true, autocomplete: 'organization' },
  {
    name: 'audience',
    label: 'Who is the audience?',
    type: 'select',
    required: true,
    options: [
      'Parents and caregivers',
      'Grandparents',
      'Daycare or preschool staff',
      'Students',
      'Church or community group',
      'Health care or first responders',
      'Pool, swim or recreation staff',
      'Something else',
    ],
  },
  {
    name: 'ageGroup',
    label: 'Age group',
    type: 'select',
    required: true,
    options: ['Adults', 'Teens', 'Kids ages 5 to 12', 'Mixed ages'],
  },
  { name: 'preferredDate', label: 'Preferred date', type: 'date' },
  { name: 'location', label: 'Town or location', autocomplete: 'address-level2', required: true },
  { name: 'message', label: 'Anything else we should know?', type: 'textarea' },
];
---

<BaseLayout
  title="Request a Talk"
  description="Invite Because of ADAM to share Adam’s story and the layers of protection with your school, daycare, church or community group."
>
  <PageHero
    eyebrow="Request a talk"
    title="Bring Adam’s story to your group."
    lede="Schools, daycares, churches, moms’ groups, pediatric offices and pool stores: we’ll share Adam’s story and teach the layers of protection."
  />
  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap narrow">
      <SiteForm
        id="talk"
        fields={fields}
        subject="Talk request from the website"
        submitLabel="Send request"
        fallbackTitle="Request a talk"
      />
    </div>
  </section>
</BaseLayout>
