---
import ProseLayout from '../layouts/ProseLayout.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import CtaBand from '../components/CtaBand.astro';
import SharePage from '../components/SharePage.astro';
import { home as story } from '../data/content';
import { url } from '../lib/url';
import { site } from '../data/site';
---

<ProseLayout slug="adams-story" type="Article">
  <div class="story-aside">
    <PhotoFrame src={story.storyPhoto || story.photo} alt={story.storyPhoto ? story.storyPhotoAlt : story.photoAlt} hint="Add a photo of Adam" />
    <div class="card story-aside__card">
      <p class="eyebrow">Adam’s Village of Hope</p>
      <p>Follow Adam on Facebook and join the thousands cheering him on.</p>
      <a class="btn btn--ocean" href={site.facebookUrl} rel="noopener" target="_blank">
        Follow on Facebook
      </a>
    </div>
    <SharePage
      label="Share Adam’s story"
      text="Adam was 14 months old when he drowned in his family’s backyard pool. He survived. His big sister tells the story, and what the family wishes they’d known."
    />
  </div>

  <CtaBand
    slot="after"
    title="Every family can add a layer today."
    text="Learn the layers that stand between a toddler and the water."
  >
    <a class="btn" href={url('/water-safety')}>See the seven layers</a>
    <a class="btn btn--ghost" href={url('/water-watcher')}>Take the pledge</a>
  </CtaBand>
</ProseLayout>

<style>
  .story-aside {
    display: grid;
    gap: 24px;
  }
  /* Phones and tablets: the photo goes above the story, the cards stay after it. */
  @media (max-width: 999px) {
    .story-aside {
      display: contents;
    }
    .story-aside > :global(.photo) {
      order: -1;
    }
  }
  /* Desktop: the column sticks beside the story on screens tall enough to show all of it. */
  @media (min-width: 1000px) and (min-height: 1040px) {
    .story-aside {
      position: sticky;
      top: 100px;
    }
  }
</style>
