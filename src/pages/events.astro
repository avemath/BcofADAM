---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents, splitEvents } from '../lib/events';
import { url } from '../lib/url';
import { event as eventLd } from '../lib/seo';

const { upcoming, past: allPast } = splitEvents(await getEvents());
// Benefits our hometown and friends held for Adam's own care, before we started Because of ADAM in 2020,
// get their own group so they're not mixed in with the nonprofit's events.
const beforeUs = (e: (typeof allPast)[number]) =>
  e.data.kind === 'Community' && (!e.data.date || e.data.date.getUTCFullYear() < 2020);
const past = allPast.filter((e) => !beforeUs(e));
const early = allPast.filter(beforeUs);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL(url('/'), Astro.site).href.replace(/\/$/, '');
// Upcoming events (including the yearly ones) as structured data for search engines.
const jsonLd = upcoming.map((e) => eventLd(e, origin, pageUrl)).filter((x) => x !== undefined);
---

<BaseLayout
  jsonLd={jsonLd}
  title="Events & Fundraisers"
  description="Cornhole tournaments, water safety days, Wear Blue on June 5, and the benefits our hometown held for Adam: every event from Adam’s village."
>
  <PageHero
    eyebrow="Events & fundraisers"
    title="Rodeos, cornhole & a whole lot of village."
    lede="Our village has been showing up since 2017: a benefit and a fishing rodeo in our hometown of Jean Lafitte, cornhole in Duncansville and blue shirts every June 5. Today, every event puts water safety in front of families who need it."
  >
    {
      upcoming.length > 0 && (
        <p class="next-up">
          Next up: <a href="#coming-up">{upcoming[0].data.title}</a>
        </p>
      )
    }
  </PageHero>

  {
    upcoming.length > 0 && (
      <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
        <div class="wrap">
          <h2 id="coming-up">Coming up</h2>
          <div class="grid grid--3" style="margin-top: 28px">
            {upcoming.map((e) => <EventCard event={e} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class={upcoming.length > 0 ? 'section section--foam' : 'section'} style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap">
      <h2>Past events</h2>
      {past.length === 0 && <p>Events are coming soon. Follow us on Facebook for dates.</p>}
      <div class="grid grid--3" style="margin-top: 28px">
        {past.map((e) => <EventCard event={e} />)}
      </div>
    </div>
  </section>

  {
    early.length > 0 && (
      <section class={upcoming.length > 0 ? 'section' : 'section section--foam'}>
        <div class="wrap">
          <h2>Before Because of ADAM</h2>
          <p class="lede">
            In 2017 and 2018, before we started Because of ADAM, our hometown and friends held benefits to help with
            Adam’s care. We’ll never be able to thank them enough.
          </p>
          <div class="grid grid--3" style="margin-top: 28px">
            {early.map((e) => <EventCard event={e} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Want to host one?"
    text="Tournaments, rodeos, swim days, bake sales, birthday fundraisers: we’ll help with water safety materials and spreading the word."
  >
    <a class="btn" href={url('/contact')}>Tell us your idea</a>
    <a class="btn btn--ghost" href={url('/get-involved')}>More ways to help</a>
  </CtaBand>
</BaseLayout>

<style>
  .next-up {
    margin-top: 1.2rem;
    font-weight: 700;
    color: #fff;
  }
  .next-up a {
    color: var(--sun);
  }
</style>
