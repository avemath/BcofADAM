---
import BaseLayout from '../layouts/BaseLayout.astro';
import SharePage from '../components/SharePage.astro';
import Album from '../components/Album.astro';
import FacebookVideo from '../components/FacebookVideo.astro';
import PageHero from '../components/PageHero.astro';
import OnThisPage from '../components/OnThisPage.astro';
import CtaBand from '../components/CtaBand.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { nonfatal, survivorsPhotos, album } from '../data/content';
import { survivorResources } from '../data/content';
import { url } from '../lib/url';

// The "Life goes on" photos, in the order the family set them in the Studio.
const moments = (survivorsPhotos.moments ?? []).filter((m) => m.photo);
// The hospital photos under "Life after a drowning".
const lifePhotos = (survivorsPhotos.lifePhotos ?? []).filter((m) => m.photo);
const hospitalVideo = (album.videos ?? [])[1];
const christmasVideo = (album.videos ?? [])[2];

// Our mom's own words sit under some of these, quoted from her posts on Adam's Facebook page.
const realities: { title: string; body: string; quote?: string; by?: string }[] = [
  {
    title: 'The hospital stay',
    body: 'Intensive care, ventilators, scans, and waiting. Our mom stood beside Adam’s crib for 33 days before she was allowed to hold him, two hours from home, with four other kids who needed her too.',
    quote: 'I decided I would be the smartest person in the room when it came to Adam’s care. I would be his voice, his advocate, his warrior mom.',
  },
  {
    title: 'Brain injury',
    body: 'When the brain goes without oxygen, the injury can affect movement, speech, eating, vision, learning and behavior. Every child’s recovery looks different.',
  },
  {
    title: 'Therapy, equipment & costs',
    body: 'Physical, occupational and speech therapy, specialists, equipment and home changes. Some treatments aren’t covered by insurance, and the costs keep going for years.',
  },
  {
    title: 'The whole family',
    body: 'Parents carry grief, guilt and exhaustion. Siblings carry their own worry. Friendships, jobs and marriages are all tested. Families need support that lasts.',
    quote: 'Every day they faced friends and strangers alike who all asked how their brother was doing. And when the answer “good” was received as “totally healed,” they had to explain that a good day just meant that he’s still alive.',
    by: 'Our mom, about Adam’s big sisters',
  },
  {
    title: 'The victories',
    body: 'Survivor families learn to celebrate everything: a smile, a laugh, a new sound, a little more strength than yesterday. Progress comes in its own time, and every bit of it counts.',
    quote: 'For 15 months, all I begged for was his smile to return.',
  },
  {
    title: 'The village',
    body: 'Nobody gets through this alone. It takes prayer warriors, meal trains, therapists, teachers, and friends who keep showing up. That’s what a village looks like.',
    quote: 'Those closest to us understand that sometimes we simply lack energy and words. We are so thankful you don’t take it personally and show up for us anyway, even if it’s just in your daily prayers.',
  },
];
---

<BaseLayout
  title="Survivors & Families"
  description="Nonfatal drowning can change a child’s life forever. Information and support for survivors of nonfatal drowning and the families who love them."
>
  <PageHero
    eyebrow="Nonfatal drowning"
    title="Surviving is only the beginning."
    lede="Adam survived. Many children do. A nonfatal drowning can change a child’s life, and a whole family’s, for good. Many drowning prevention groups were started in memory of a child who died. Ours was started for one who lived."
  />
  <OnThisPage />

  {
    survivorsPhotos.photo && (
      <section class="section" style="padding-block: clamp(40px, 6vw, 72px) 0">
        <div class="wrap narrow">
          <PhotoFrame src={survivorsPhotos.photo} alt={survivorsPhotos.photoAlt} caption={survivorsPhotos.caption} ratio="3 / 2" natural />
        </div>
      </section>
    )
  }

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap narrow">
      <span class="eyebrow">If this is your family</span>
      <h2>You are not alone.</h2>
      <p class="lede">
        Drowning happens to loving, careful families. Ours is one of them. If your child survived a drowning and you
        want to talk, find help, or tell your story so it protects another child, write to us.
      </p>
      <div class="btn-row">
        <a class="btn btn--ocean" href={url('/contact')}>Write to us</a>
      </div>

      <p class="how-lead">People often tell our mom, Shannon, “I don’t know how you do it.” In 2024 she answered:</p>
      <blockquote class="mom-words how-quote reveal">
        <p>
          “The fact is, we’re not interested in the alternative. We’ve been there. … We keep busy, so we don’t go
          backwards. We work hard to show our children that it’s okay to get knocked down, it’s okay to grieve, but it
          is our responsibility to quietly get up, keep pushing forward and do the next right thing.”
        </p>
        <cite>Our mom, Shannon</cite>
      </blockquote>

      <h3 style="margin-top: 56px">Places to find help</h3>
      <ul class="resource-list">
        {
          survivorResources.map((r) => (
            <li>
              <a href={r.url} rel="noopener" target="_blank">
                {r.name}
              </a>
              <span>{r.description}</span>
            </li>
          ))
        }
      </ul>
      <p class="callout" style="margin-top: 32px">
        <strong>A note on treatment.</strong>
        Families of drowning survivors often hear about many different therapies. Our family shares what
        helped Adam, but every child is different. Please make treatment decisions with your child’s
        medical team.
      </p>
    </div>
  </section>

  <section class="section section--foam">
    <div class="wrap split split--wide-left" style="align-items: start">
      <div class="reveal">
        <h2>What “nonfatal drowning” means</h2>
        <p>
          Health experts define drowning as having trouble breathing because the body went under or
          into water. Many children survive a drowning. Some recover completely. Others, like Adam,
          live with injuries that last a lifetime.
        </p>
        <p>
          That’s why we say Adam <em>is</em> a drowning survivor. He didn’t “almost drown.” He drowned,
          and he survived.
        </p>
        {survivorsPhotos.photo2 && <PhotoFrame src={survivorsPhotos.photo2} alt={survivorsPhotos.photo2Alt} caption={survivorsPhotos.caption2} ratio="4 / 5" natural />}
      </div>
      <div class="reveal">
        <div class="card">
        <p class="eyebrow">By the numbers</p>
        <ul class="nf-stats">
          {
            nonfatal.map((f) => (
              <li>
                <strong>{f.stat}</strong>
                <span>{f.label}</span>
                <a class="source" href={f.sourceUrl} rel="noopener" target="_blank">
                  {f.source}
                </a>
              </li>
            ))
          }
        </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">What families face</span>
      <h2>Life after a drowning</h2>
      {
        lifePhotos.length > 0 && (
          <div class="life-photos">
            {lifePhotos.map((m) => (
              <PhotoFrame src={m.photo} alt={m.alt} caption={m.caption} natural />
            ))}
          </div>
        )
      }
      {
        hospitalVideo?.url && (
          <Album summary={`Watch: ${hospitalVideo.title}`} note={`${hospitalVideo.date}, from our mom’s page`} more>
            <FacebookVideo url={hospitalVideo.url} title={hospitalVideo.title!} caption={hospitalVideo.caption} />
          </Album>
        )
      }
      <div class="grid grid--2" style="margin-top: 32px">
        {
          realities.map((r) => (
            <div class="card reveal">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
              {r.quote && (
                <blockquote class="mom-words">
                  <p>“{r.quote}”</p>
                  <cite>{r.by ?? 'Our mom'}</cite>
                </blockquote>
              )}
            </div>
          ))
        }
      </div>

      {
        moments.length > 0 && (
          <div class="moments reveal">
            <span class="eyebrow">Life goes on</span>
            <h3>{survivorsPhotos.momentsTitle}</h3>
            <p>{survivorsPhotos.momentsText}</p>
            <div class="moments__grid">
              {moments.map((m) => (
                <div class:list={['moments__item', { 'moments__item--wide': m.wide }]}>
                  <PhotoFrame src={m.photo} alt={m.alt} caption={m.caption} ratio={m.wide ? '5 / 3' : '4 / 5'} />
                </div>
              ))}
            </div>
            {
              christmasVideo?.url && (
                <Album summary={`Watch: ${christmasVideo.title}`} note={`${christmasVideo.date}, from our mom’s page`} more>
                  <FacebookVideo url={christmasVideo.url} title={christmasVideo.title!} caption={christmasVideo.caption} />
                </Album>
              )
            }
          </div>
        )
      }

      <aside class="sibling-note reveal" aria-labelledby="sibling-title">
        {survivorsPhotos.siblingPhoto && <div class="sibling-note__photo"><PhotoFrame src={survivorsPhotos.siblingPhoto} alt={survivorsPhotos.siblingPhotoAlt} caption={survivorsPhotos.siblingCaption} ratio="4 / 5" /></div>}
        <div class="sibling-note__text">
        <p class="eyebrow">For brothers and sisters</p>
        <h3 id="sibling-title">A note from Adam’s big sister</h3>
        <p>
          I was 14 when Adam drowned. Mom and Dad went to Pittsburgh with him, and Mom stayed for months. My sisters and
          I stayed in Duncansville and started a new school year without her. For a long time, every conversation
          anyone had with us was about the hospital.
        </p>
        <p>
          I learned to do what his nurses do. I can change his
          trach and give him oxygen in an emergency. Being able to help is what made it feel like my family again, and
          not just something happening to us.
        </p>
        <p>
          If your brother or sister survived a drowning, you don’t have to be fine. Ask to learn one thing about their
          care, and spend time with them that isn’t about the hospital. Adam can’t talk, but he hears everything, and he
          knows who’s in the room.
        </p>
        <p class="sibling-note__sign">Avery</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--foam">
    <div class="wrap narrow">
      <span class="eyebrow">For friends, neighbors and everyone else</span>
      <h2>How to support a family after a drowning</h2>
      <blockquote class="big-quote reveal">
        <p>“For every tragic story you read, there are family members in horrendous pain blaming themselves. … When you hear these stories, pause and find kindness.”</p>
        <cite>Our mom, Shannon</cite>
      </blockquote>
      <ul class="support-list">
        <li><strong>Don’t judge.</strong> Drowning happens to loving, careful families. Skip the comments section.</li>
        <li><strong>Keep showing up.</strong> Months and years later, not just the first week.</li>
        <li><strong>Help with the ordinary.</strong> Meals, laundry, and rides to school and practice for the brothers and sisters.</li>
        <li><strong>Say the child’s name.</strong> Ask how they’re doing, and celebrate every milestone with them.</li>
        <li><strong>Never say “move on.”</strong> This kind of grief doesn’t end. Help them carry it.</li>
      </ul>
      <SharePage label="Send this page to a family who needs it" text="If your child survived a drowning, you are not alone. A family that has lived it, on what comes next and where to find help." />
    </div>
  </section>

  <CtaBand
    title="Pass it on."
    text="If you know a family living life after a drowning, send them this page. If you are that family, write to us."
  >
    <a class="btn" href={url('/contact')}>Write to us</a>
    <a class="btn btn--ghost" href={url('/adams-story')}>Read Adam’s story</a>
  </CtaBand>
</BaseLayout>

<style>
  .nf-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .nf-stats strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--ocean);
  }
  .nf-stats span {
    display: block;
    margin: 6px 0 2px;
  }
  .sibling-note {
    max-width: 760px;
    margin: clamp(32px, 5vw, 48px) auto 0;
    padding: clamp(22px, 3vw, 32px);
    background: #fff;
    border-radius: var(--radius);
    border-left: 6px solid var(--sun);
    box-shadow: var(--shadow);
  }
  .sibling-note h3 {
    margin-bottom: 0.5em;
  }
  .sibling-note__sign {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ocean);
    margin-bottom: 0;
  }
  .mom-words {
    margin: 14px 0 0;
    padding: 10px 0 0 16px;
    border-left: 3px solid var(--sun);
  }
  .mom-words p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--ocean);
    margin: 0 0 4px;
  }
  .mom-words cite {
    font-style: normal;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .big-quote {
    margin: 32px 0;
    padding-left: 24px;
    border-left: 4px solid var(--aqua);
  }
  .big-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.4vw + 1rem, 1.9rem);
    line-height: 1.35;
    color: var(--ocean);
    margin-bottom: 0.5em;
  }
  .big-quote cite {
    font-style: normal;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .support-list {
    padding-left: 1.2em;
    display: grid;
    gap: 10px;
  }
  .resource-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .resource-list li {
    padding: 16px 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .resource-list a {
    font-weight: 700;
    display: block;
  }
  .resource-list span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .split :global(.photo) {
    margin-top: 28px;
  }
  .how-lead {
    margin: 40px 0 0;
  }
  .how-quote {
    margin-top: 10px;
  }
  .life-photos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 20px 24px;
  }
  /* Specific enough to beat the photo component's own natural-height rule. */
  .life-photos :global(.photo--natural) {
    margin-inline: 0;
  }
  .life-photos :global(.photo--natural img) {
    max-height: min(400px, 60vh);
  }
  .moments {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .moments h3 {
    font-size: clamp(1.5rem, 1vw + 1.1rem, 2rem);
    margin-bottom: 0.4em;
  }
  .moments > p {
    max-width: 64ch;
  }
  .moments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
  }
  .moments__item--wide {
    grid-column: span 2;
  }
  .moments__grid :global(img) {
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 24px -14px rgb(4 29 43 / 0.45);
  }
  .moments__grid :global(figcaption) {
    font-size: 0.85rem;
    margin-top: 8px;
  }
  @media (min-width: 760px) {
    .moments__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
  }
  .sibling-note__photo {
    max-width: 300px;
    margin-bottom: 24px;
  }
  @media (min-width: 900px) {
    .sibling-note {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 36px;
      align-items: start;
    }
    .sibling-note__photo {
      margin-bottom: 0;
    }
  }
</style>
