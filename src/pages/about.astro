---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, nonprofitLine } from '../data/site';
import { url } from '../lib/url';
import PhotoFrame from '../components/PhotoFrame.astro';
import { about, team } from '../data/content';

// Each value ends with our mom's own words, quoted from her posts on Adam's Facebook page.
const values = [
  {
    title: 'Honest',
    body: 'We tell the truth about drowning, including the hard parts, and we cite our sources.',
    said: 'Layer up. There are no do-overs.',
  },
  {
    title: 'Hopeful',
    body: 'Adam is proof that hope matters. Drowning is preventable, and every family can add layers of protection.',
    said: 'In His time.',
  },
  {
    title: 'Without blame',
    body: 'Drowning happens to loving, careful families. Shame keeps people silent, and silence costs lives.',
    said: 'When you hear these stories, pause and find kindness.',
  },
  {
    title: 'Community',
    body: 'It takes a village. We work alongside parents, schools, first responders, swim instructors and other drowning prevention groups.',
    said: 'Our village shines just as bright as the fireflies’ village.',
  },
];

---

<BaseLayout
  title="About Us"
  description={`${site.name}: ${site.tagline} was founded by Adam’s family to prevent childhood drowning and support families affected by it.`}
>
  <PageHero
    eyebrow="About us"
    title="It started with our little brother."
    lede="Adam survived a drowning in our backyard pool when he was 14 months old. In 2020, his big brother and sisters (that’s us) started Because of ADAM: Allies in the Drowning Awareness Movement, so other families could learn from his story. His village has been growing ever since."
  />

  {
    (about.photo || !site.launchReady) && (
      <section class="section about-photo" style="padding-block: clamp(40px, 6vw, 72px) 0">
        <div class="wrap narrow reveal">
          <PhotoFrame src={about.photo} alt={about.photoAlt} caption={about.caption} ratio="3 / 2" natural hint="Family photo goes here: add it in the Studio" />
        </div>
      </section>
    )
  }

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Our mission</span>
        <h2 class="mission">To end childhood drowning by learning from our past, teaching water safety today, and protecting the generations to come.</h2>
        <p class="lede">Learn from our past. Protect your future.</p>
      </div>
      <div class="acronym reveal" aria-label={`ADAM stands for ${site.tagline}`}>
        <p><span>A</span>llies</p>
        <p class="acronym__small">in the</p>
        <p><span>D</span>rowning</p>
        <p><span>A</span>wareness</p>
        <p><span>M</span>ovement</p>
      </div>
    </div>
  </section>

  <section class="section section--foam">
    <div class="wrap narrow letter reveal">
      <span class="eyebrow">A note from Avery</span>
      <h2>Why we started this</h2>
      <p>
        I was 14 when my little brother drowned in our backyard pool. What happened that day is on
        <a href={url('/adams-story')}>Adam’s story</a>. This page is about what we did next.
      </p>
      <p>
        Adam survived, and I spent the rest of high school growing up alongside his therapies and hospital stays. Along
        the way I learned how little most families know about how drowning really happens, because we didn’t know
        either.
      </p>
      <p>
        In 2020, my brother, sisters and I started Because of ADAM. This website is everything we wish someone had told
        us in 2017, in one place, free for anyone who needs it.
      </p>
      <p>
        If you take one thing from it, make it this: no single layer is enough, so stack them. And if you ever can’t
        find a child, check the water first.
      </p>
      <p class="letter__sign">Avery, Adam’s big sister</p>
      <a class="btn btn--ocean" href={url('/adams-story')}>Read Adam’s story</a>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap narrow name-quote reveal">
      <span class="eyebrow">What our name means</span>
      <blockquote>
        <p>“Everyone loves Adam, and we are all better and smarter people because of him.”</p>
        <cite>Lea, Adam’s sister, age 7</cite>
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="wrap logo-story">
      <img class="logo-story__mark reveal" src={url('/images/logo-mark-large.png')} sizes="(min-width: 500px) 300px, 60vw" alt="Our logo: a brain with a heart-shaped center" width="601" height="707" loading="lazy" />
      <div class="reveal">
        <span class="eyebrow">Where our logo comes from</span>
        <h2>A heart where we least expected one.</h2>
        <p>
          A few months after the accident, Adam had a special brain scan called a SPECT scan. It shows which parts of the
          brain are getting oxygen and which parts were hurt when they couldn’t. On Adam’s scan, the part that was hurt
          showed up dark, and it was shaped like a perfect heart.
        </p>
        <blockquote class="logo-story__quote">
          <p>Rather than devastation, I was flooded with immense hope.</p>
          <cite>Our mom</cite>
        </blockquote>
        <p>That heart is our logo. To us, it’s what Because of ADAM is all about: finding hope in hopeless places.</p>
      </div>
    </div>
  </section>

  <section class="section section--foam">
    <div class="wrap">
      <span class="eyebrow">What we believe</span>
      <h2>Our values</h2>
      <div class="grid grid--4" style="margin-top: 28px">
        {
          values.map((v) => (
            <div class="card reveal">
              <h3>{v.title}</h3>
              <p>{v.body}</p>
              <p class="value__said">
                “{v.said}” <span>Our mom</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Who we are</span>
      <h2>Our team</h2>
      <ul class="grid grid--3 team" style="margin-top: 28px">
        {
          team.map((m) => (
            <li class="card team__card">
              {m.photo ? (
                <img src={url(m.photo)} sizes="(min-width: 1000px) 300px, (min-width: 600px) 50vw, 100vw" alt={m.photoAlt || m.name} data-missing-alt={!m.photoAlt || undefined} loading="lazy" />
              ) : (
                !site.launchReady && <PhotoFrame ratio="4 / 3" hint="Add a photo in the Studio" />
              )}
              <h3>{m.name}</h3>
              <p class="team__role">{m.role}</p>
              {m.bio && <p>{m.bio}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap narrow">
      <span class="eyebrow">Transparency</span>
      <h2>Accountable to our village</h2>
      <p>
        {
          nonprofitLine ||
          `${site.name} is a family-run nonprofit effort. We’ll post our registration details here as soon as they’re final.`
        }{' '}
        We’ll share annual reports and IRS filings on this page as they become available.
      </p>
    </div>
  </section>

  <CtaBand title="Walk with us." text="Share what you learn, come to an event, and tell one more parent to check the water first.">
    <a class="btn" href={url('/get-involved')}>Get involved</a>
    <a class="btn btn--ghost" href={url('/contact')}>Contact us</a>
  </CtaBand>
</BaseLayout>

<style>
  .letter p:not(.letter__sign) {
    font-size: 1.1rem;
  }
  .letter__sign {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ocean);
    margin: 1.4em 0 1.2em;
  }
  .value__said {
    margin: 1em 0 0;
    padding-top: 0.9em;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.4;
    color: var(--ocean);
  }
  .value__said span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .mission {
    font-size: clamp(1.6rem, 1.6vw + 1rem, 2.4rem);
    line-height: 1.25;
  }
  .acronym {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw + 1rem, 4rem);
    line-height: 1.05;
    color: var(--ink-soft);
  }
  .acronym p {
    margin: 0;
  }
  .acronym__small {
    font-size: 0.45em;
    font-style: italic;
    padding-left: 0.2em;
  }
  .acronym span {
    color: var(--ocean);
    font-weight: 700;
  }
  .name-quote blockquote {
    margin: 0;
  }
  .name-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.6vw + 1rem, 3rem);
    line-height: 1.25;
    color: #fff;
    margin-bottom: 0.6em;
  }
  .name-quote cite {
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.875rem;
    color: var(--sun);
  }
  .logo-story {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 800px) {
    .logo-story {
      grid-template-columns: minmax(160px, 300px) minmax(0, 1fr);
    }
  }
  .logo-story__mark {
    width: min(300px, 60vw);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 24px 40px rgb(4 29 43 / 0.25));
  }
  .logo-story__quote {
    margin: 1.4em 0;
    padding-left: 1em;
    border-left: 4px solid var(--sun);
  }
  .logo-story__quote p {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.2vw + 1rem, 1.7rem);
    font-style: italic;
    line-height: 1.35;
    color: var(--deep);
    margin: 0;
  }
  .logo-story__quote cite {
    display: block;
    margin-top: 0.5em;
    font-style: normal;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ocean);
  }
  .team__card :global(.photo) {
    margin-bottom: 16px;
  }
  .team__card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
  }
  .team__role {
    font-weight: 700;
    color: var(--ocean);
    margin-bottom: 0.5em;
  }
  .team {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
