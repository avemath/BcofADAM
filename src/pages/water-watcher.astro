---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const promises = [
  'When children are in or near the water, I will name one adult as the Water Watcher.',
  'When I’m the Water Watcher, I will put my phone away and keep my eyes on the water.',
  'I will hand the job to another adult every 15 minutes, so the Water Watcher always has fresh eyes.',
  'I will stay within arm’s reach of toddlers and weak swimmers.',
  'I will keep pool gates closed and alarms on, especially when we have guests.',
  'If a child is missing, I will check the water first.',
  'I will learn CPR, and I will share what I know with the people I love.',
];
---

<BaseLayout
  title="Take the Water Watcher Pledge"
  description="Promise to be a Water Watcher: one adult, eyes on the water, no distractions. Take the pledge and print your Water Watcher card."
>
  <PageHero
    eyebrow="Water Watcher pledge"
    title="When everyone is watching, no one is."
    lede="A Water Watcher is one adult whose only job is to watch the water, until they hand the job to the next adult, every 15 minutes. Make the promise, print a card, and pass it on."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split" style="align-items: start">
      <form class="pledge card" data-pledge>
        <h2>I promise…</h2>
        <p class="pledge__why">
          “YOU are taking the necessary steps to prevent tragedy by being a water watcher.” <cite>Our mom, Shannon, July 2018</cite>
        </p>
        <ul>
          {
            promises.map((p, i) => (
              <li>
                <label>
                  <input type="checkbox" name={`p${i}`} />
                  <span>{p}</span>
                </label>
              </li>
            ))
          }
        </ul>
        <label class="pledge__name">
          <span>Your name, for the card (optional)</span>
          <input type="text" name="name" maxlength="40" autocomplete="name" data-name />
        </label>
        <p class="pledge__done" role="status" aria-live="polite"></p>
        <div class="btn-row no-print">
          <button type="button" class="btn" data-share>Share the pledge</button>
          <button type="button" class="btn btn--ghost" data-print>Print my Water Watcher card</button>
        </div>
      </form>

      <div>
        <h2 class="visually-hidden">Printable Water Watcher card</h2>
        <div class="ww-card" id="ww-card">
          <div class="ww-card__top">
            <span class="ww-card__eyebrow">I am the</span>
            <span class="ww-card__title">Water Watcher</span>
            <span class="ww-card__name" data-card-name hidden></span>
          </div>
          <ul>
            <li>I watch the water. Nothing else.</li>
            <li>No phone. No distractions.</li>
            <li>Toddlers stay within arm’s reach.</li>
            <li>Every 15 minutes, I hand this tag to another adult.</li>
          </ul>
          <p class="ww-card__time">
            On duty until: <span></span>
          </p>
          <div class="ww-card__foot">
            <Logo light />
            <span>Missing child? <strong>Check the water first.</strong> Call 911.</span>
          </div>
        </div>
        <p class="source" style="margin-top: 12px">
          Print it, laminate it, punch a hole and add a lanyard. Keep one in your pool bag, lake bag and beach bag.
        </p>
        <p class="source">
          Why 15 minutes? Watching water is hard work, and attention fades.{' '}
          <a href="https://www.safekids.org/tip/swimming-safety-tips" rel="noopener" target="_blank">
            Safe Kids Worldwide<span class="visually-hidden"> (source for switching Water Watchers every 15 minutes, opens in a new tab)</span>
          </a>{' '}
          recommends choosing a new Water Watcher every 15 minutes.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ siteName: site.name }}>
    const form = document.querySelector('[data-pledge]');
    const boxes = form.querySelectorAll('input[type=checkbox]');
    const done = form.querySelector('.pledge__done');
    const nameInput = form.querySelector('[data-name]');
    const cardName = document.querySelector('[data-card-name]');
    const KEY = 'bcoa:pledge';
    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || 'null') || null;
      } catch {
        return null;
      }
    };
    const write = (value) => {
      try {
        if (value) localStorage.setItem(KEY, JSON.stringify(value));
        else localStorage.removeItem(KEY);
      } catch {
        /* private window or storage off */
      }
    };
    const niceDate = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    const showName = () => {
      const name = nameInput.value.trim();
      cardName.textContent = name;
      cardName.hidden = !name;
    };
    const update = () => {
      const all = [...boxes].every((b) => b.checked);
      form.classList.toggle('is-complete', all);
      const saved = read();
      if (all) {
        const when = saved?.date || new Date().toISOString();
        write({ date: when, name: nameInput.value.trim() });
        done.textContent = saved?.date
          ? `You took the pledge on ${niceDate(saved.date)}. Thank you for keeping it. Print your card any time.`
          : 'Thank you. You’re a Water Watcher. Now pass it on.';
      } else {
        if (saved) write(null);
        done.textContent = '';
      }
    };
    boxes.forEach((b) => b.addEventListener('change', update));
    nameInput.addEventListener('input', () => {
      showName();
      const saved = read();
      if (saved) write({ ...saved, name: nameInput.value.trim() });
    });
    // Took the pledge before? Pick up where you left off.
    const saved = read();
    if (saved?.date) {
      boxes.forEach((b) => (b.checked = true));
      if (saved.name) nameInput.value = saved.name;
      showName();
      update();
    }
  
    form.querySelector('[data-print]').addEventListener('click', () => window.print());
    form.querySelector('[data-share]').addEventListener('click', async () => {
      const data = {
        title: `Take the Water Watcher pledge | ${siteName}`,
        text: 'I took the Water Watcher pledge. When kids are near water, one adult watches, no distractions. Will you?',
        url: location.href,
      };
      try {
        if (navigator.share) await navigator.share(data);
        else {
          await navigator.clipboard.writeText(`${data.text} ${data.url}`);
          done.textContent = 'Link copied. Paste it anywhere to share.';
        }
      } catch (error) {
        // Closing the share sheet is fine. Anything else (like no clipboard access): show the link to copy.
        if (error?.name !== 'AbortError') done.textContent = `Copy this link to share: ${data.url}`;
      }
    });
  </script>

  <CtaBand title="Next: your own home." text="Walk through the house and yard with the checklist, one layer at a time.">
    <a class="btn" href={url('/checklist')}>Print the checklist</a>
    <a class="btn btn--ghost" href={url('/water-safety')}>See the layers</a>
  </CtaBand>
</BaseLayout>



<style>
  .pledge ul {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: grid;
    gap: 10px;
  }
  .pledge label {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .pledge label:hover {
    background: var(--foam);
  }
  .pledge input {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    accent-color: var(--ocean);
  }
  .pledge__why {
    margin: 0 0 1em;
    color: var(--ink-soft);
  }
  .pledge__why cite {
    display: block;
    font-style: normal;
    font-size: 0.875rem;
    font-weight: 700;
  }
  /* More specific than the checkbox rows' flex rule above. */
  .pledge .pledge__name {
    display: grid;
    gap: 6px;
    margin: 16px 0 4px;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .pledge .pledge__name input {
    width: 100%;
    min-width: 0;
    max-width: 360px;
    padding: 10px 12px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    font: inherit;
  }
  .pledge .pledge__name input:focus-visible {
    outline: 3px solid var(--aqua);
    outline-offset: 2px;
  }
  .ww-card__name {
    display: block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }
  .pledge__done {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ocean);
    min-height: 1.5em;
    margin: 0;
  }

  .ww-card {
    background: linear-gradient(160deg, var(--ocean), var(--abyss));
    color: #fff;
    border-radius: 22px;
    padding: 28px;
    max-width: 440px;
    margin-inline: auto;
    box-shadow: 0 30px 60px -30px rgb(4 29 43 / 0.7);
    border: 3px solid var(--sun);
  }
  .ww-card__top {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
  }
  .ww-card__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sun);
  }
  .ww-card__title {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
  }
  .ww-card ul {
    padding-left: 1.1em;
    margin: 0 0 18px;
  }
  .ww-card li {
    margin-bottom: 6px;
  }
  .ww-card__time span {
    display: inline-block;
    min-width: 120px;
    border-bottom: 2px solid rgb(255 255 255 / 0.6);
  }
  .ww-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    padding-top: 16px;
    font-size: 0.85rem;
  }
  .ww-card__foot strong {
    color: var(--sun);
  }

  @media print {
    :global(.page-hero),
    :global(.skip-link),
    .pledge,
    .source {
      display: none !important;
    }
    :global(.split) {
      display: block !important;
    }
    :global(main .section) {
      padding: 0 !important;
    }
    .ww-card {
      margin: 0.5in auto;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      box-shadow: none;
    }
  }
  /* All seven promises ticked: the card gets a gold edge and printing the card becomes the main button. */
  .is-complete {
    outline: 3px solid var(--sun);
    outline-offset: 6px;
  }
  .is-complete [data-share] {
    --btn-bg: transparent;
    --btn-fg: currentColor;
    border-color: currentColor;
  }
  .is-complete [data-print] {
    --btn-bg: var(--sun);
    --btn-fg: var(--abyss);
    border-color: var(--sun);
  }
</style>
