---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import SiteForm, { type Field } from '../components/SiteForm.astro';
import { url } from '../lib/url';
import { hasDonate } from '../data/site';

const ways = [
  {
    title: 'Take the pledge',
    body: 'Promise to be a Water Watcher, print your card, and ask your family to do the same.',
    href: '/water-watcher',
    cta: 'Take the pledge',
  },
  {
    title: 'Share a flyer',
    body: 'Print our one-page flyer and handout cards for your pediatrician’s office, daycare, church nursery or babysitter.',
    href: '/flyer',
    cta: 'Print the flyer',
  },
  {
    title: 'Take the water safety quiz',
    body: 'Ten quick questions with a source for every answer, and a certificate to print. Then send it to the people who watch your kids.',
    href: '/quiz',
    cta: 'Take the quiz',
  },
  {
    title: 'Come to an event',
    body: 'Fishing rodeos, cornhole tournaments and water safety days. Bring your family, bring your friends, and learn something that could save a life.',
    href: '/events',
    cta: 'See our events',
  },
  {
    title: 'Wear Blue on June 5',
    body: 'Every June 5, the anniversary of Adam’s drowning, we wear blue for his hope and strength. Post a photo with #WearBlueJune5th and a water safety tip.',
    href: '/news/2018-06-04-the-color-of-love',
    cta: 'Why blue?',
  },
  {
    title: 'Share Adam’s story',
    body: 'Every share puts water safety in front of a parent, grandparent or babysitter who might need it today.',
    href: '/adams-story',
    cta: 'Read & share',
  },
  {
    title: 'Invite us to speak',
    body: 'Schools, daycares, churches, moms’ groups, pediatric offices and pool stores: we’ll come tell Adam’s story and teach the layers of protection.',
    href: '/request-a-talk',
    cta: 'Request a talk',
  },
  {
    title: 'Host a fundraiser',
    body: 'A cornhole tournament, a fishing rodeo, a swim-a-thon or a birthday fundraiser. We’ll help with materials and ideas.',
    href: '/contact',
    cta: 'Tell us your idea',
  },
  {
    title: 'Partner with us',
    body: 'Pool builders, swim schools, realtors, insurers and local businesses can help new pool owners get the layers right from day one.',
    href: '/contact',
    cta: 'Become a partner',
  },
];

if (hasDonate) {
  ways.splice(2, 0, {
    title: 'Give',
    body: 'Help put Water Watcher tags, alarms, CPR training and water safety education within reach of more families.',
    href: '/donate',
    cta: 'Donate',
  });
}

const shareText = [
  'Drowning is the #1 cause of death for kids ages 1–4, and it’s preventable. Learn the layers of protection: fences, alarms, Water Watchers, swim skills and CPR. #BecauseOfADAM',
  'When everyone is watching, no one is. Name a Water Watcher every time kids are near water. #BecauseOfADAM #AdamsVillage',
  'It only takes a second to latch a gate, switch on an alarm, or put down the phone. #BecauseOfADAM',
  'Skills before thrills. Learn from our past, protect your future. #BecauseOfADAM #LayerUp',
  'If a child is missing, check the water first. Every second counts. #BecauseOfADAM',
  // These three are our mom's own words from Adam's Facebook page.
  'Decide today to make layers of protection a priority with your little ones. It’s so very worth it. Layer up. There are no do-overs. #BecauseOfADAM #LayerUp',
  'Water is beautiful and fun, until it’s not. Stack the layers: a Water Watcher, a four-sided fence, alarms, swim skills and CPR. #BecauseOfADAM',
  'For the Fourth of July: once the swim time settles, floaties come off, clean up time begins and fireworks start, please remember that little ones are still drawn to the water. #BecauseOfADAM',
];

const volunteerFields: Field[] = [
  { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
  { name: 'area', label: 'Town or area', required: true, autocomplete: 'address-level2' },
  {
    name: 'interests',
    label: 'I’d like to help with',
    type: 'checkboxes',
    options: ['Events', 'Water safety talks', 'Sharing on social media', 'Fundraising', 'Something else'],
  },
  { name: 'message', label: 'Anything else?', type: 'textarea' },
];
---

<BaseLayout
  title="Get Involved"
  description="Join the movement: take the Water Watcher pledge, share Adam’s story, give, host a fundraiser, or invite Because of ADAM to speak."
>
  <PageHero
    eyebrow="Join the movement. Become an Ally."
    title="Adam’s village is bigger than one family."
    lede="Everyone who shares, pledges, gives or speaks up becomes another layer of protection for a child they may never meet."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap grid grid--3">
      {
        ways.map((w) => (
          <article class="card way reveal">
            <h2 class="way__title">{w.title}</h2>
            <p>{w.body}</p>
            <a class="btn btn--ocean" href={url(w.href)}>
              {w.cta}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--foam">
    <div class="wrap narrow">
      <span class="eyebrow">Share toolkit</span>
      <h2>Copy, paste, post.</h2>
      <p class="lede">Use these anywhere: Facebook, Instagram, the group chat, the church bulletin.</p>
      <ul class="share-list">
        {
          shareText.map((t) => (
            <li class="card">
              <p>{t}</p>
              <button type="button" class="btn btn--ghost copy-btn" data-copy={t}>
                Copy text
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="volunteer">
    <div class="wrap narrow">
      <span class="eyebrow">Volunteer</span>
      <h2>Lend a hand.</h2>
      <p class="lede">Tell us where you are and what you’d like to help with, and we’ll reach out when something comes up.</p>
      <SiteForm
        id="volunteer-form"
        fields={volunteerFields}
        subject="Volunteer sign-up from the website"
        submitLabel="Sign me up"
        fallbackTitle="Volunteer with us"
      />
    </div>
  </section>

  <CtaBand title="Have another idea?" text="We’d love to hear it. Tell us how you want to help.">
    <a class="btn" href={url('/contact')}>Get in touch</a>
  </CtaBand>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy text'), 2000);
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>

<style>
  .way {
    display: flex;
    flex-direction: column;
  }
  .way__title {
    font-size: 1.6rem;
  }
  .way .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .share-list {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 16px;
  }
  .share-list p {
    font-size: 1.05rem;
  }
  .copy-btn {
    min-height: 40px;
    padding: 0.5em 1.1em;
    font-size: 0.9rem;
    color: var(--ocean);
  }
</style>
