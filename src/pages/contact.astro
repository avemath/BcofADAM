---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SiteForm, { type Field } from '../components/SiteForm.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const topics = [
  'General question',
  'Invite us to speak',
  'Share my family’s story',
  'Host a fundraiser',
  'Partnership',
  'Media / press',
];
const fields: Field[] = [
  { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
  { name: 'topic', label: 'What’s this about?', type: 'select', options: topics },
  { name: 'message', label: 'Message', type: 'textarea', required: true },
];
---

<BaseLayout title="Contact" description="Get in touch with Because of ADAM: questions, speaking requests, partnerships, media, or to share your family’s story.">
  <PageHero
    eyebrow="Contact"
    title="Write to us. One of us will write back."
    lede="Because of ADAM is run by Adam’s brother and sisters, so your message comes straight to our family. Questions, talk requests, fundraiser ideas, or your own family’s story: we read all of it."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split">
      <div>
        <SiteForm id="contact" fields={fields} subject="Message from the website" submitLabel="Send message" fallbackTitle="Send us a message" />
      </div>
      <div class="contact-side">
        <div class="callout callout--warn">
          <strong>In an emergency, call 911.</strong>
          We don’t check messages around the clock. If a child is missing, check the water first.
        </div>
        <div class="card contact-card">
          <h2>If your child is a drowning survivor</h2>
          <p>
            We would be honored to hear from you. Whether you want to talk, find resources, or just tell someone who
            understands, write to us. Our mom has walked this road since 2017, and she’s still walking it.
          </p>
          <a href={url('/survivors-and-families')}>Support for survivor families →</a>
        </div>
        {
          site.facebookUrl && (
            <div class="card contact-card">
              <h2>Follow along</h2>
              <p>Our mom posts Adam’s milestones and water safety reminders on his Facebook page all year long.</p>
              <a href={site.facebookUrl} rel="noopener" target="_blank">
                Adam’s Village of Hope on Facebook<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-side {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .contact-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.4em;
  }
  .contact-card p {
    margin-bottom: 0.6em;
  }
  .contact-card a {
    font-weight: 700;
  }
  @media (min-width: 900px) {
    .split {
      align-items: start;
    }
  }
</style>
