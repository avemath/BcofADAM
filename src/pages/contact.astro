---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SiteForm, { type Field } from '../components/SiteForm.astro';

const topics = [
  'General question',
  'Invite us to speak',
  'Share my family’s story',
  'Host a fundraiser',
  'Partnership',
  'Media / press',
];
const fields: Field[] = [
  { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
  { name: 'topic', label: 'What’s this about?', type: 'select', options: topics },
  { name: 'message', label: 'Message', type: 'textarea', required: true },
];
---

<BaseLayout title="Contact" description="Get in touch with Because of ADAM: questions, speaking requests, partnerships, media, or to share your family's story.">
  <PageHero
    eyebrow="Contact"
    title="We’d love to hear from you."
    lede="Questions, speaking requests, partnership ideas, or your own family’s story. Reach out any time."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split">
      <div>
        <SiteForm id="contact" fields={fields} subject="Message from the website" submitLabel="Send message" fallbackTitle="Send us a message" />
      </div>
      <div class="callout callout--warn">
        <strong>In an emergency, call 911.</strong>
        This form isn’t monitored around the clock. If a child is missing, check the water first.
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (min-width: 900px) {
    .split {
      align-items: start;
    }
  }
</style>
