---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const topics = [
  'General question',
  'Invite us to speak',
  'Share my family’s story',
  'Host a fundraiser',
  'Partnership',
  'Media / press',
];
---

<BaseLayout title="Contact" description="Get in touch with Because of ADAM: questions, speaking requests, partnerships, media, or to share your family's story.">
  <PageHero
    eyebrow="Contact"
    title="We’d love to hear from you."
    lede="Questions, speaking requests, partnership ideas, or your own family’s story. Reach out any time."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split">
      <div>
        {
          site.contactFormAction ? (
            <form class="contact-form card" action={site.contactFormAction} method="POST">
              <div class="field">
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="topic">What’s this about?</label>
                <select id="topic" name="topic">
                  {topics.map((t) => <option>{t}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required />
              </div>
              <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button class="btn btn--ocean" type="submit">Send message</button>
            </form>
          ) : (
            <div class="card">
              <h2>Send us a message</h2>
              {site.email ? (
                <p>
                  Email us at <a href={`mailto:${site.email}`}>{site.email}</a>. We read every message.
                </p>
              ) : (
                <p>
                  Our contact form is coming soon. For now, message us on{' '}
                  <a href={site.social.facebook} rel="noopener" target="_blank">
                    Facebook
                  </a>
                  .
                </p>
              )}
            </div>
          )
        }
      </div>
      <div class="callout callout--warn">
        <strong>In an emergency, call 911.</strong>
        This form isn’t monitored around the clock. If a child is missing, check the water first.
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form {
    display: grid;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field label {
    font-weight: 700;
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 12px 14px;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    background: #fff;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--aqua);
    outline: none;
  }
  .contact-form .btn {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .split {
      align-items: start;
    }
  }
</style>
