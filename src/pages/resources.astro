---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { resourceGroups, survivorResources } from '../data/content';
import { url } from '../lib/url';

const guides = [
  { name: 'Printable home water safety checklist', href: '/checklist', description: 'Walk through your home and yard layer by layer, plus a half-page for babysitters and grandparents.' },
  { name: 'Water safety in Pennsylvania', href: '/pennsylvania', description: 'Lakes and rivers near Blair County, cold water, ice, flash floods and Pennsylvania’s life jacket rules.' },
  { name: 'Water Watcher pledge and card', href: '/water-watcher', description: 'Make the promise and print a Water Watcher card for your pool bag.' },
  { name: 'Teens, life jackets and CPR', href: '/water-safety#more', description: 'Water safety for older kids, how to pick a life jacket, a pool recall to check, and where to learn CPR.' },
];

const groups = [...resourceGroups, { title: 'For survivors & families', items: survivorResources }];
---

<BaseLayout
  title="Resources"
  description="Trusted drowning prevention, CPR, swim lesson and family support resources, gathered in one place by a family that has lived it."
>
  <PageHero
    eyebrow="Resources"
    title="Trusted help, all in one place."
    lede="Pediatricians, public health agencies, the groups fighting drowning alongside us, and the help families need after a drowning. Start here."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap">
      <div class="res-group reveal">
        <h2>Our guides</h2>
        <ul class="grid grid--2">
          {
            guides.map((g) => (
              <li class="card">
                <h3>
                  <a href={url(g.href)}>{g.name}</a>
                </h3>
                <p>{g.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
      {
        groups.map((g) => (
          <div class="res-group reveal">
            <h2>{g.title}</h2>
            <ul class="grid grid--2">
              {g.items.map((r) => (
                <li class="card">
                  <h3>
                    <a href={r.url} rel="noopener" target="_blank">
                      {r.name}
                    </a>
                  </h3>
                  <p>{r.description}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="source">
        Links go to other organizations’ websites. We aren’t responsible for their content, and including a
        link doesn’t mean they endorse us.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .res-group {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .res-group h2 {
    font-size: clamp(1.6rem, 2vw + 1rem, 2.2rem);
  }
  .res-group ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }
  .res-group h3 {
    font-size: 1.2rem;
  }
  .res-group h3 a {
    text-decoration: none;
  }
  .res-group h3 a:hover {
    text-decoration: underline;
  }
</style>
