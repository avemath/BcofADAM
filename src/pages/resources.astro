---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { resourceGroups, survivorResources } from '../data/content';

const groups = [...resourceGroups, { title: 'For survivors & families', items: survivorResources }];
---

<BaseLayout
  title="Resources"
  description="Trusted drowning prevention, CPR, swim lesson and family support resources, all in one place."
>
  <PageHero
    eyebrow="Resources"
    title="Trusted help, all in one place."
    lede="We point you to the experts: pediatricians, public health agencies and fellow drowning prevention organizations whose work we trust."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap">
      {
        groups.map((g) => (
          <div class="res-group reveal">
            <h2>{g.title}</h2>
            <ul class="grid grid--2">
              {g.items.map((r) => (
                <li class="card">
                  <h3>
                    <a href={r.url} rel="noopener" target="_blank">
                      {r.name}
                    </a>
                  </h3>
                  <p>{r.description}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="source">
        Links go to other organizations’ websites. We aren’t responsible for their content, and including a
        link doesn’t mean they endorse us.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .res-group {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .res-group h2 {
    font-size: clamp(1.6rem, 2vw + 1rem, 2.2rem);
  }
  .res-group ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }
  .res-group h3 {
    font-size: 1.2rem;
  }
  .res-group h3 a {
    text-decoration: none;
  }
  .res-group h3 a:hover {
    text-decoration: underline;
  }
</style>
