---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { url } from '../lib/url';
---

<BaseLayout noindex searchable={false} title="Page not found" description="We couldn’t find that page. Try our water safety guide, Adam’s story or the home page.">
  <PageHero eyebrow="404" title="We couldn’t find that page." lede="It may have moved, or the link may have a typo. These are good places to start.">
    <div class="btn-row">
      <a class="btn" href={url('/')}>Home</a>
      <a class="btn btn--ghost" href={url('/water-safety')}>Water safety</a>
      <a class="btn btn--ghost" href={url('/adams-story')}>Adam’s story</a>
      <button class="btn btn--ghost" type="button" data-search-open>Search the site</button>
    </div>
  </PageHero>
  <div style="height: 80px"></div>
</BaseLayout>
