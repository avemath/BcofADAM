---
/**
 * Printable home water safety checklist, plus a half-page for babysitters and
 * grandparents. Edit the wording in the Studio (Pages → Home water safety checklist).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { checklist as c } from '../data/content';
import { site } from '../data/site';
import { url } from '../lib/url';

const host = Astro.site?.host ?? 'becauseofadam.org';
---

<BaseLayout
  noindex
  title="Printable Home Water Safety Checklist"
  description="A printable checklist of the layers of protection for your home and yard, with a half-page for babysitters and grandparents."
>
  <section class="section checklist-page">
    <div class="wrap narrow">
      <p class="placeholder no-print">{'{{TODO: family review}}'}</p>

      <div class="no-print checklist-actions">
        <button type="button" class="btn btn--ocean" data-print>Print or save as PDF</button>
        <a class="btn btn--ghost" href={url('/water-safety')}>Learn about each layer</a>
        <a class="btn btn--ghost" href={url('/flyer')}>Flyer for offices and daycares</a>
      </div>
      <p class="no-print checklist-saved" data-saved-note hidden>
        Your checks are saved on this device, so you can come back and finish later.
        <button type="button" class="link-button" data-clear>Clear my checks</button>
      </p>

      <article class="sheet" aria-labelledby="checklist-title">
        <header class="sheet__head">
          <Logo />
          <div>
            <h1 id="checklist-title">{c.title}</h1>
            <p>{c.intro}</p>
          </div>
        </header>
        <div class="sheet__grid">
          {
            c.sections.map((sec, si) => (
              <fieldset class="sheet__section">
                <legend>{sec.title}</legend>
                <ul>
                  {sec.items.map((item, i) => (
                    <li>
                      <label>
                        <input type="checkbox" name={`s${si}-${i}`} />
                        <span>{item}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            ))
          }
        </div>
        <p class="sheet__foot">
          <b>If a child is missing, <strong>check the water first.</strong> In an emergency, <strong>call 911.</strong></b>
          <span>{site.name} · {host}</span>
        </p>
      </article>

      <article class="sheet sheet--sitter" aria-labelledby="sitter-title">
        <p class="sheet__cut" aria-hidden="true">✂ Cut here and keep it on the fridge</p>
        <h2 id="sitter-title">{c.sitterTitle}</h2>
        <p>{c.sitterIntro}</p>
        <ul class="sitter-list">
          {c.sitterItems.map((item) => <li>{item}</li>)}
        </ul>
        <dl class="blanks">
          {
            c.sitterBlanks.map((b) => (
              <div>
                <dt>{b}</dt>
                <dd />
              </div>
            ))
          }
        </dl>
        <p class="sheet__foot">
          <strong>In an emergency, call 911.</strong>
          <span>{site.name} · {host}</span>
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Remember checked boxes on this device (by their wording, so edits in the Studio don't mix them up).
  // Private browsing can block storage; then the checklist just works without remembering.
  const KEY = 'becauseofadam-checklist';
  const boxes = [...document.querySelectorAll<HTMLInputElement>('.sheet input[type="checkbox"]')];
  const note = document.querySelector<HTMLElement>('[data-saved-note]');
  const keyFor = (box: HTMLInputElement) => box.closest('label')?.textContent?.trim() ?? box.name;
  let saved: Record<string, boolean> = {};
  try {
    saved = JSON.parse(localStorage.getItem(KEY) ?? '{}') ?? {};
  } catch {
    saved = {};
  }
  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(saved));
      if (note) note.hidden = !Object.values(saved).some(Boolean);
    } catch {
      /* storage blocked: nothing to do */
    }
  };
  boxes.forEach((box) => {
    if (saved[keyFor(box)]) box.checked = true;
    box.addEventListener('change', () => {
      saved[keyFor(box)] = box.checked;
      save();
    });
  });
  if (note) note.hidden = !boxes.some((b) => b.checked);
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    boxes.forEach((b) => (b.checked = false));
    saved = {};
    save();
  });
</script>

<style>
  .checklist-page {
    padding-top: clamp(32px, 5vw, 56px);
  }
  .checklist-saved {
    margin: -16px 0 28px;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .link-button {
    border: 0;
    background: none;
    padding: 0 4px;
    min-height: 24px;
    font: inherit;
    font-weight: 700;
    color: var(--ocean);
    text-decoration: underline;
    cursor: pointer;
  }
  .checklist-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 16px 0 32px;
  }
  .sheet {
    background: #fff;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(20px, 4vw, 36px);
    margin-bottom: 32px;
  }
  .sheet__head {
    display: grid;
    gap: 12px;
    border-bottom: 3px solid var(--ocean);
    padding-bottom: 16px;
    margin-bottom: 20px;
  }
  .sheet h1 {
    font-size: clamp(1.8rem, 2vw + 1rem, 2.4rem);
    margin: 0 0 0.3em;
  }
  .sheet__head p {
    margin: 0;
  }
  .sheet__grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .sheet__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sheet__section {
    border: 0;
    padding: 0;
    margin: 0;
    break-inside: avoid;
  }
  .sheet__section legend {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--deep);
    padding: 0;
    margin-bottom: 6px;
  }
  .sheet__section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .sheet__section label {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    min-height: 32px;
    line-height: 1.4;
  }
  .sheet__section input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }
  .sheet__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    border-top: 1px solid var(--line);
    margin: 20px 0 0;
    padding-top: 12px;
    font-size: 0.95rem;
  }
  .sheet__foot b {
    font-weight: 400;
  }
  .sheet__foot span {
    color: var(--ink-soft);
  }
  .sheet--sitter h2 {
    font-size: 1.6rem;
    margin: 0 0 0.3em;
  }
  .sheet__cut {
    font-size: 0.8rem;
    color: var(--ink-soft);
    border-bottom: 2px dashed var(--line);
    padding-bottom: 6px;
    margin: 0 0 16px;
  }
  .sitter-list {
    padding-left: 1.2em;
    margin: 0 0 16px;
  }
  .sitter-list li {
    margin-bottom: 4px;
  }
  .blanks {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  @media (min-width: 720px) {
    .blanks {
      grid-template-columns: 1fr 1fr;
    }
  }
  .blanks div {
    display: flex;
    gap: 8px;
    align-items: flex-end;
  }
  .blanks dt {
    font-weight: 700;
    white-space: nowrap;
  }
  .blanks dd {
    flex: 1;
    margin: 0;
    min-height: 1.6em;
    border-bottom: 1.5px solid var(--ink-soft);
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.preview-ribbon),
    :global(.skip-link),
    .no-print {
      display: none !important;
    }
    .checklist-page {
      padding: 0 !important;
    }
    .sheet {
      border: 0;
      padding: 0;
      margin: 0;
      font-size: 10.5pt;
    }
    .sheet h1 {
      font-size: 20pt;
    }
    .sheet__grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px 18px;
    }
    .sheet__section label {
      min-height: 0;
    }
    .sheet--sitter {
      break-before: page;
      font-size: 11pt;
    }
    .blanks {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
