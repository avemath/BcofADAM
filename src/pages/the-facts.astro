---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import OnThisPage from '../components/OnThisPage.astro';
import CtaBand from '../components/CtaBand.astro';
import { factGroups } from '../data/content';
import { url } from '../lib/url';
---

<BaseLayout
  title="The Facts About Drowning"
  description="Drowning is the leading cause of death for children ages 1–4. The facts about child drowning and nonfatal drowning, with sources."
>
  <PageHero
    eyebrow="The facts"
    title="Drowning is fast, silent, and preventable."
    lede="Every number on this page is a child and a family. One of them is ours. We link to the source for every number, skip the viral ones nobody can trace, and end with what works."
  />
  <OnThisPage />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap">
      {
        factGroups.map((g) => (
          <div class="fact-group">
            <h2 class="reveal">{g.title}</h2>
            {g.intro && <p class="lede reveal">{g.intro}</p>}
            <div class="grid grid--3">
              {g.facts.map((f) => (
                <article class="fact reveal">
                  <p class:list={['fact__stat', { 'fact__stat--word': !/\d/.test(f.stat) }]}>{f.stat}</p>
                  <p class="fact__label">{f.label}</p>
                  {f.detail && <p class="fact__detail">{f.detail}</p>}
                  <p class="source">
                    Source:{' '}
                    <a href={f.sourceUrl} rel="noopener" target="_blank">
                      {f.source}
                      <span class="visually-hidden"> (source for “{f.stat}”, opens in a new tab)</span>
                    </a>
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))
      }

      <div class="callout">
        <strong>A note on words.</strong>
        We say <em>nonfatal drowning</em>, not “near-drowning.” And “dry drowning” and “secondary drowning”
        aren’t medical terms. If a child has trouble breathing, keeps coughing, or seems unusually sleepy or
        confused after being in the water, get medical care right away.
      </div>
    </div>
  </section>

  <CtaBand title="Facts don’t save lives. People do." text="Put the layers of protection in place today.">
    <a class="btn" href={url('/water-safety')}>See the seven layers</a>
    <a class="btn btn--ghost" href={url('/quiz')}>Test yourself: take the quiz</a>
  </CtaBand>
</BaseLayout>

<style>
  .fact-group {
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .fact-group .grid {
    margin-top: 28px;
  }
  /* Number, then the bar, then what it means. Sources line up along the bottom. */
  .fact {
    display: flex;
    flex-direction: column;
  }
  .fact .source {
    margin-top: auto;
  }
  .fact__stat--word {
    font-size: clamp(1.8rem, 1vw + 1.4rem, 2.4rem) !important;
    line-height: 1.1;
  }
  .fact__stat {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw + 1rem, 4.2rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ocean);
    padding-bottom: 16px;
    border-bottom: 4px solid var(--aqua);
    margin-bottom: 16px;
  }
  .fact__label {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .fact__detail {
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
</style>
