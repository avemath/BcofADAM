---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, hasDonate } from '../data/site';
import { url } from '../lib/url';

// No donation link yet? Send visitors to Get Involved instead of a dead end.
// Add the link in the Studio (Site settings → Donation link) and this page
// and every Donate button appear automatically.
if (!hasDonate) return Astro.redirect(url('/get-involved'));

/**
 * What a gift does. Only list programs we actually run or have committed to.
 * (A 501(c)(3) can't raise money for one specific child's care, so gifts stay
 * tied to the mission: education, prevention tools, and support for families.)
 */
const impact = [
  {
    title: 'Water Watcher tags & cards',
    body: 'Water Watcher tags in the hands of parents, grandparents and babysitters at events, pediatric offices and pool stores.',
  },
  {
    title: 'Layers of protection',
    body: 'Door alarms, pool alarms and other layers that buy families precious seconds.',
  },
  {
    title: 'Swim lessons & CPR',
    body: 'Help for families who want self-rescue swim lessons, and CPR classes so more adults are ready to act.',
  },
  {
    title: 'Survivor families',
    body: 'Resources and connection for families facing life after a nonfatal drowning.',
  },
];
---

<BaseLayout
  title="Donate"
  description="Support Because of ADAM's drowning awareness and prevention work."
>
  <PageHero
    eyebrow="Give"
    title="Every gift adds a layer of protection."
    lede="Your support helps us teach families about drowning, put prevention tools in their hands, and stand beside families after a drowning."
  />

  <section class="section" style="padding-top: clamp(40px, 6vw, 72px)">
    <div class="wrap split">
      <div>
        <h2>What your gift makes possible</h2>
        <div class="grid">
          {
            impact.map((i) => (
              <div class="card">
                <h3>{i.title}</h3>
                <p>{i.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="donate-box card">
        <h2>Give securely online</h2>
        <p>You’ll go to our secure giving page. Monthly gifts help us plan ahead. Thank you for being part of Adam’s village.</p>
        <a class="btn" href={site.donateUrl} rel="noopener">Donate now</a>
        <p class="source" style="margin-top: 24px">
          {
            site.taxExempt
              ? `${site.name} is a 501(c)(3) nonprofit organization${site.ein ? ` (EIN ${site.ein})` : ''}. Donations are tax-deductible to the extent allowed by law.`
              : 'Our 501(c)(3) tax-exempt status isn’t confirmed yet, so please don’t count gifts as tax-deductible for now. We’ll update this page when it is.'
          }
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .donate-box {
    background: var(--deep);
    color: var(--on-dark);
    border: 0;
  }
  .donate-box .source {
    color: var(--on-dark-soft);
  }
  @media (min-width: 900px) {
    .donate-box {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
</style>
