---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import TimeOnPage from '../components/TimeOnPage.astro';
import LayersBuilder from '../components/LayersBuilder.astro';
import CtaBand from '../components/CtaBand.astro';
import HomeNumbers from '../components/HomeNumbers.astro';
import WhereTonight from '../components/WhereTonight.astro';
import ExpectReality from '../components/ExpectReality.astro';
import SeasonStrip from '../components/SeasonStrip.astro';
import SharePage from '../components/SharePage.astro';
import { layers } from '../data/layers';
import { home as story } from '../data/content';
import AnywhereAnytime from '../components/AnywhereAnytime.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents, splitEvents } from '../lib/events';
import { site } from '../data/site';
import { isr } from '../data/content';
import { url } from '../lib/url';
import { withAge } from '../lib/age';

const events = await getEvents();
const countWord = (n: number) =>
  ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][n] ?? String(n);
const { upcoming } = splitEvents(events);
// Home shows upcoming events first, then anything marked "Show on the home page".
// Highlight the key phrase in the hero intro if it's there.
const ledeParts = (story.heroLede ?? '').split('#1 cause of death');
// The second survivors number (hospital stays) sits next to the survivors section.
const homeEvents = [...upcoming, ...events.filter((e) => e.data.featured && !upcoming.includes(e))].slice(0, 1);
---

<BaseLayout
  documentTitle={`${site.name} | Water Safety and Drowning Prevention in PA`}
  shareTitle={`${site.name}: ${site.tagline}`}
  description="Drowning is the #1 cause of death for kids ages 1 to 4. Adam survived. Learn the layers of protection that keep children safe around water."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__caustics" aria-hidden="true"></div>
    <div class="hero__bubbles" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`} />)}
    </div>
    <div class="wrap hero__inner">
      <div class="hero__text">
        {
          story.heroPhoto && (
            <div class="hero__photo">
              <img src={url(story.heroPhoto)} alt={story.heroPhotoAlt} sizes="(min-width: 900px) 560px, 88px" loading="eager" fetchpriority="high" />
              <span class="hero__photo-caption">{withAge(story.heroCaption)}</span>
            </div>
          )
        }
        <h1 class="hero__title">
          <span class="hero__line">Drowning is silent.</span>{' '}
          <span class="hero__line hero__line--2">We won’t be.</span>
        </h1>
        <p class="hero__lede">
          {
            ledeParts.length === 2 ? (
              <>
                {ledeParts[0]}
                <strong>#1 cause of death</strong>
                {ledeParts[1]}
              </>
            ) : (
              story.heroLede
            )
          }
        </p>
        <p class="hero__by">From Adam’s brother and sisters · {site.location}</p>
        <div class="btn-row">
          <a class="btn" href="#tonight">Five things to do tonight</a>
          <a class="btn btn--ghost" href={url('/adams-story')}>Read Adam’s story</a>
        </div>
        <p class="hero__chip">
          <strong>#1 cause of death</strong> for kids ages 1 to 4 ·{' '}
          <a href="https://www.cdc.gov/drowning/data-research/facts/index.html" rel="noopener" target="_blank">
            CDC<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </div>
    <Wave color="var(--sand)" animated />
  </section>

  <SeasonStrip />
  <ExpectReality />

  <!-- TONIGHT -->
  <section id="tonight" class="section" style="padding-top: clamp(32px, 5vw, 64px)">
    <div class="wrap">
      <span class="eyebrow">Start tonight</span>
      <h2>{story.tonightTitle}</h2>
      {story.tonightIntro && <p class="lede layers-lede">{story.tonightIntro}</p>}
      <WhereTonight generic="tonight-all" />
      <ol class="tonight" id="tonight-all">
        {
          (story.tonight ?? []).map((t, i) => (
            <li class="card reveal">
              <span class="tonight__num" aria-hidden="true">{i + 1}</span>
              <p>{t}</p>
            </li>
          ))
        }
      </ol>
      <div class="btn-row">
        <a class="btn btn--ocean" href={url('/water-safety')}>See the {countWord(layers.length).toLowerCase()} layers</a>
        <a class="btn btn--ghost" href={url('/checklist')}>Print the home checklist</a>
      </div>
      <div class="tonight__send">
        <SharePage compact label="Who watches your kids this week? Send them tonight’s checks." text="Five things you can do tonight to keep kids safe around water, from a family that knows." />
      </div>
      <div class="missing-callout reveal" role="note">
        <h3>If a child is missing, check the water first.</h3>
        <p>
          Pools, hot tubs, ponds, bathtubs, even buckets. Every second counts. Call 911 and start CPR if you’re trained.
        </p>
        <a href={url('/water-safety#emergency')}>What to do in an emergency →</a>
      </div>
    </div>
  </section>

  <!-- THE NUMBERS -->
  <HomeNumbers />

  <!-- ANYWHERE, ANYTIME -->
  <Wave color="var(--deep)" bg="var(--sand)" />
  <AnywhereAnytime />
  <Wave color="var(--foam)" bg="var(--deep)" />

  <!-- ADAM -->
  <section class="section section--foam">
    <div class="wrap split">
      <div class="reveal">
        <PhotoFrame src={story.photo} alt={story.photoAlt} hint="Add a photo of Adam" />
      </div>
      <div class="reveal">
        <span class="eyebrow">Adam’s story</span>
        <h2>{story.meetTitle}</h2>
        <p class="lede">{withAge(story.teaser)}</p>
        {story.teaserMore && <p>{withAge(story.teaserMore)}</p>}
        <div class="btn-row">
          <a class="btn btn--ocean" href={url('/adams-story')}>Read Adam’s story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOCK -->
  <Wave color="var(--deep)" bg="var(--foam)" />
  <section class="section section--deep clock-section">
    <div class="wrap narrow reveal">
      <TimeOnPage />
    </div>
  </section>
  <Wave color="var(--abyss)" bg="var(--deep)" />

  <!-- LAYERS BUILDER -->
  <section id="layers" class="section section--abyss">
    <div class="wrap">
      <div class="layers-intro reveal">
        <span class="eyebrow">Layers of protection</span>
        <h2>No single layer is enough.</h2>
        <p class="lede">
          Our door alarms went quiet when a door was pulled almost shut but never latched. Gates get propped open.
          Adults look away. Each layer you add catches what the last one misses. Turn them on and see the difference.
        </p>
      </div>
      <LayersBuilder />
    </div>
  </section>
  <Wave color="var(--deep)" bg="var(--abyss)" />

  <!-- ISR -->
  <section class="section section--deep isr-band">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Infant Swimming Resource (ISR)</span>
        <h2>Teaching babies to save themselves.</h2>
        <p class="lede">{isr.blurb}</p>
        <ul class="isr-points">
          <li><strong>6–12 months:</strong> roll onto their back, float and breathe</li>
          <li><strong>1–6 years:</strong> swim, roll over to float and rest, then swim again</li>
          <li><strong>One-on-one,</strong> about 10 minutes a day with a certified instructor</li>
        </ul>
        {
          isr.stance && (
            <p class="isr-stance">
              {isr.stance}{' '}
              <a href={url('/swim-lessons#why-we-recommend-isr-not-just-swim-lessons')}>Why we recommend ISR</a>
            </p>
          )
        }
        <div class="btn-row">
          <a class="btn" href={url('/swim-lessons')}>About ISR lessons</a>
          <a class="btn btn--ghost" href={url('/swim-lessons#find')}>Find an instructor near you</a>
        </div>
      </div>
      <div class="isr-card reveal">
        <p class="isr-card__label">Why this is personal</p>
        <p class="isr-card__name">Adam’s nearest ISR instructor was two hours away.</p>
        <p>After Adam drowned, our dad became one. Wherever you live, ISR’s map lists every certified instructor near you.</p>
        <p class="isr-card__quote">“Skills before thrills. No matter the cost, the time commitment or the distance, sometimes there are no do-overs.”</p>
        <p class="isr-card__by">Our mom, Shannon</p>
      </div>
    </div>
  </section>
  <Wave color="var(--foam)" bg="var(--deep)" />

  <!-- SURVIVORS -->
  <section class="section section--foam" style="padding-top: clamp(32px, 5vw, 64px)">
    <div class="wrap narrow">
      <div class="reveal">
        <span class="eyebrow">Survivors & families</span>
        <h2>Surviving is only the beginning.</h2>
        <p class="lede">
          Many drowning prevention groups were started in memory of a child who died. Ours was started for one who
          lived. If your child came home from a drowning, there’s a page here for you, and a family behind it.
        </p>
        <div class="btn-row">
          <a class="btn btn--ocean" href={url('/survivors-and-families')}>Support for families</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PLEDGE -->
  <CtaBand
    title="Be the Water Watcher."
    text="Promise to be the one adult whose only job is the water, and print your card."
  >
    <a class="btn" href={url('/water-watcher')}>Take the pledge</a>
    <a class="btn btn--ghost" href={url('/quiz')}>Take the quiz</a>
  </CtaBand>

  <!-- EVENTS -->
  {
    homeEvents.length > 0 && (
      <section class="section">
        <div class="wrap">
          <span class="eyebrow">Events & fundraisers</span>
          <h2>Next up.</h2>
          <p class="lede">Cornhole in Duncansville, blue shirts every June 5, and a tent with a “Never swim alone” poster. Come meet the village.</p>
          <div class="home-events" style="margin-top: 32px">
            {homeEvents.map((e) => <EventCard event={e} />)}
          </div>
          <div class="btn-row">
            <a class="btn btn--ocean" href={url('/events')}>All our events</a>
          </div>
        </div>
      </section>
    )
  }

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    background:
      radial-gradient(50% 45% at 85% -5%, rgb(255 214 120 / 0.55) 0%, transparent 70%),
      radial-gradient(120% 70% at 70% -10%, #3fb3c4 0%, transparent 60%),
      linear-gradient(180deg, var(--ocean-bright) 0%, var(--ocean) 48%, var(--deep) 100%);
  }
  .hero__caustics {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(12% 8% at 20% 20%, rgb(255 255 255 / 0.3), transparent 70%),
      radial-gradient(10% 6% at 60% 12%, rgb(255 244 214 / 0.35), transparent 70%),
      radial-gradient(14% 9% at 85% 30%, rgb(255 255 255 / 0.22), transparent 70%),
      radial-gradient(9% 7% at 40% 38%, rgb(255 255 255 / 0.18), transparent 70%),
      conic-gradient(from 200deg at 80% -20%, transparent 0 40%, rgb(255 244 214 / 0.16) 45%, transparent 50% 60%, rgb(255 255 255 / 0.12) 64%, transparent 70%);
    filter: blur(8px);
    animation: caustics 16s ease-in-out infinite alternate;
  }
  @keyframes caustics {
    to {
      transform: translate3d(4%, 3%, 0) rotate(3deg) scale(1.08);
    }
  }
  .hero__bubbles span {
    position: absolute;
    bottom: -20px;
    left: calc(var(--i) * 7.3%);
    width: calc(4px + (var(--i) * 7 % 9) * 1px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(255 255 255 / 0.08);
    animation: rise calc(10s + var(--i) * 1.3s) linear infinite;
    animation-delay: calc(var(--i) * -1.7s);
  }
  @keyframes rise {
    to {
      transform: translate3d(calc(sin(var(--i)) * 30px), -110vh, 0);
      opacity: 0;
    }
  }
  .hero__inner {
    position: relative;
    padding-top: clamp(80px, 14vh, 160px);
    padding-bottom: clamp(24px, 6vh, 64px);
  }
  /* On phones, don't make people scroll past empty sky to reach the words. */
  @media (max-width: 640px) {
    .hero {
      min-height: auto;
    }
    .hero__inner {
      padding-top: 56px;
    }
  }
  .hero__inner {
    display: grid;
    gap: 24px;
  }
  /* On a phone the photo is a small round portrait above the headline; on a desktop it fills the right side. */
  .hero__photo {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .hero__photo img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
    border: 3px solid rgb(255 255 255 / 0.85);
    box-shadow: 0 10px 30px -10px rgb(4 29 43 / 0.6);
  }
  .hero__photo-caption {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
  }
  @media (min-width: 900px) {
    .hero .hero__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      align-items: end;
      gap: 16px 48px;
      padding-top: 48px;
    }
    /* Beside the photo the headline runs a size smaller, so each line stays whole. */
    .hero .hero__title {
      font-size: clamp(3rem, 4vw + 0.4rem, 4.8rem);
      margin-bottom: 0.2em;
    }
    .hero__line--2 {
      white-space: nowrap;
    }
    .hero__text {
      display: contents;
    }
    .hero__photo {
      display: block;
      position: relative;
      order: 2;
      grid-column: 2;
      grid-row: 1 / span 5;
      align-self: end;
      margin: 0;
    }
    .hero__photo img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      max-height: min(520px, 62vh);
      border: 0;
      border-radius: var(--radius);
      box-shadow: none;
      object-position: center 20%;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%);
      mask-image: linear-gradient(to right, transparent 0, #000 22%);
    }
    .hero__photo-caption {
      position: absolute;
      right: 16px;
      bottom: 14px;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgb(4 29 43 / 0.55);
      font-size: 1rem;
    }
    .hero__title,
    .hero__lede,
    .hero__by,
    .hero .btn-row,
    .hero__chip {
      grid-column: 1;
    }
  }
  .hero__by {
    margin: -4px 0 20px;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .hero__chip {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 20px 0 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(4 29 43 / 0.45);
    font-size: 0.85rem;
    color: var(--on-dark);
  }
  .hero__chip strong {
    color: var(--sun);
  }
  .hero__chip a {
    color: #fff;
  }
  .hero__title {
    font-size: clamp(3rem, 8.4vw + 0.5rem, 7.6rem);
    text-shadow: 0 2px 30px rgb(4 29 43 / 0.35);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 0.35em;
  }
  .hero__line {
    display: block;
    animation: surface 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__line--2 {
    font-style: italic;
    color: var(--sun);
    animation-delay: 0.25s;
  }
  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(8px);
    }
  }
  .hero__lede {
    font-size: clamp(1.15rem, 0.8vw + 1rem, 1.5rem);
    max-width: 44ch;
    color: var(--on-dark);
  }
  .hero__lede strong {
    color: var(--sun);
  }
  .hero .btn-row {
    margin-top: 4px;
  }

  .tonight__send {
    max-width: 640px;
    margin-top: 28px;
  }

  /* ---------- Stats ---------- */
  .stat__num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 4vw + 1rem, 4.6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ocean);
    margin-bottom: 12px;
  }

  /* ---------- Clock ---------- */
  .clock-section {
    padding-block: clamp(56px, 9vw, 112px);
  }

  /* ---------- Layers ---------- */
  .layers-intro {
    max-width: 760px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .layers-lede {
    max-width: 62ch;
    margin-bottom: 2rem;
  }
  .tonight {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    gap: 12px;
    max-width: 720px;
  }
  .tonight li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
  }
  .tonight p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .tonight__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--foam);
    color: var(--ocean);
    font-weight: 800;
  }
  .missing-callout {
    margin-top: 28px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--deep);
    color: var(--on-dark);
    border-left: 8px solid var(--sun);
  }
  .missing-callout h3 {
    color: var(--sun);
    margin-bottom: 0.3em;
  }
  .missing-callout a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--shallow);
    font-weight: 700;
  }

  /* ---------- Survivors ---------- */

  /* ---------- ISR ---------- */
  .isr-band {
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .isr-points {
    padding-left: 1.2em;
    margin: 0 0 8px;
    display: grid;
    gap: 6px;
  }
  .isr-stance {
    margin-top: 1.25rem;
    padding-left: 14px;
    border-left: 3px solid var(--sun);
    color: var(--on-dark);
    font-weight: 600;
    max-width: 52ch;
  }
  .isr-card {
    background:
      radial-gradient(50% 60% at 100% 100%, rgb(255 214 120 / 0.18), transparent 70%),
      linear-gradient(340deg, var(--ocean-bright), var(--ocean));
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 44px);
    color: #fff;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .isr-card__label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sun-text);
    margin-bottom: 6px;
  }
  .isr-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2vw + 1rem, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
  }
  .isr-card__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    margin: 1.2em 0 0;
    padding-top: 1em;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }
  .isr-card__by {
    margin: 6px 0 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  /* Give the feed the bigger side on wide screens so it can scale up. */
  @media (min-width: 900px) {
    .fb-split {
      grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    }
    .fb-split > :first-child {
      position: sticky;
      top: 110px;
    }
  }

  .home-events {
    max-width: 460px;
  }

</style>
