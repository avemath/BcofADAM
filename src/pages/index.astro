---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import TimeOnPage from '../components/TimeOnPage.astro';
import LayersBuilder from '../components/LayersBuilder.astro';
import CtaBand from '../components/CtaBand.astro';
import { nonfatal } from '../data/content';
import HomeNumbers from '../components/HomeNumbers.astro';
import { layers } from '../data/layers';
import { home as story } from '../data/content';
import FacebookFeed from '../components/FacebookFeed.astro';
import PediatriciansSay from '../components/PediatriciansSay.astro';
import AnywhereAnytime from '../components/AnywhereAnytime.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents, splitEvents } from '../lib/events';
import { site, hasDonate } from '../data/site';
import { isr } from '../data/content';
import { url } from '../lib/url';

const events = await getEvents();
const countWord = (n: number) =>
  ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][n] ?? String(n);
const { upcoming } = splitEvents(events);
// Home shows upcoming events first, then anything marked "Show on the home page".
// Highlight the key phrase in the hero intro if it's there.
const ledeParts = (story.heroLede ?? '').split('#1 cause of death');
// The second survivors number (hospital stays) sits next to the survivors section.
const survivorStat = nonfatal[1] ?? nonfatal[0];
const homeEvents = [...upcoming, ...events.filter((e) => e.data.featured && !upcoming.includes(e))].slice(0, 3);
---

<BaseLayout
  documentTitle={`${site.name} | Water Safety and Drowning Prevention in PA`}
  shareTitle={`${site.name}: ${site.tagline}`}
  description="Drowning is the #1 cause of death for kids ages 1 to 4. Adam survived. Learn the layers of protection that keep children safe around water."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__caustics" aria-hidden="true"></div>
    <div class="hero__bubbles" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`} />)}
    </div>
    <div class="wrap hero__inner">
      <p class="hero__eyebrow">
        Because of <strong>ADAM</strong> · <span>{site.tagline}</span>
      </p>
      <h1 class="hero__title">
        <span class="hero__line">Drowning is silent.</span>{' '}
        <span class="hero__line hero__line--2">We won’t be.</span>
      </h1>
      <p class="hero__lede">
        {
          ledeParts.length === 2 ? (
            <>
              {ledeParts[0]}
              <strong>#1 cause of death</strong>
              {ledeParts[1]}
            </>
          ) : (
            story.heroLede
          )
        }
      </p>
      <div class="btn-row">
        <a class="btn" href={url('/adams-story')}>Read Adam’s story</a>
        <a class="btn btn--ghost" href="#layers">Learn the layers of protection</a>
      </div>
    </div>
    <Wave color="var(--sand)" animated />
  </section>

  <!-- THE NUMBERS -->
  <HomeNumbers />

  <!-- ANYWHERE, ANYTIME -->
  <Wave color="var(--deep)" bg="var(--sand)" />
  <AnywhereAnytime />
  <Wave color="var(--foam)" bg="var(--deep)" />

  <!-- ADAM -->
  <section class="section section--foam">
    <div class="wrap split">
      <div class="reveal">
        <PhotoFrame src={story.photo} alt={story.photoAlt} hint="Add a photo of Adam" />
      </div>
      <div class="reveal">
        <span class="eyebrow">Adam’s story</span>
        <h2>{story.meetTitle}</h2>
        <p class="lede">{story.teaser}</p>
        {story.teaserMore && <p>{story.teaserMore}</p>}
        <div class="btn-row">
          <a class="btn btn--ocean" href={url('/adams-story')}>Read Adam’s story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOCK -->
  <Wave color="var(--deep)" bg="var(--foam)" />
  <section class="section section--deep clock-section">
    <div class="wrap narrow reveal">
      <TimeOnPage />
    </div>
  </section>

  <!-- LAYERS BUILDER -->
  <section id="layers" class="section section--abyss">
    <div class="wrap">
      <div class="layers-intro reveal">
        <span class="eyebrow">Layers of protection</span>
        <h2>No single layer is enough.</h2>
        <p class="lede">
          Our door alarms went quiet when a door was pulled almost shut but never latched. Gates get propped open.
          Adults look away. Each layer you add catches what the last one misses. Turn them on and see the difference.
        </p>
      </div>
      <LayersBuilder />
    </div>
  </section>
  <Wave color="var(--sand)" bg="var(--abyss)" />

  <!-- TONIGHT -->
  <section class="section" style="padding-top: clamp(32px, 5vw, 64px)">
    <div class="wrap">
      <span class="eyebrow">Start tonight</span>
      <h2>{story.tonightTitle}</h2>
      {story.tonightIntro && <p class="lede layers-lede">{story.tonightIntro}</p>}
      <ol class="tonight">
        {
          (story.tonight ?? []).map((t, i) => (
            <li class="card reveal">
              <span class="tonight__num" aria-hidden="true">{i + 1}</span>
              <p>{t}</p>
            </li>
          ))
        }
      </ol>
      <div class="btn-row">
        <a class="btn btn--ocean" href={url('/water-safety')}>See all {countWord(layers.length).toLowerCase()} layers</a>
        <a class="btn btn--ghost" href={url('/checklist')}>Print the home checklist</a>
      </div>
      <div class="missing-callout reveal" role="note">
        <h3>If a child is missing, check the water first.</h3>
        <p>
          Pools, hot tubs, ponds, bathtubs, even buckets. Every second counts. Call 911 and start CPR if you’re trained.
        </p>
        <a href={url('/water-safety#emergency')}>What to do in an emergency →</a>
      </div>
    </div>
  </section>

  <!-- ISR -->
  <Wave color="var(--deep)" bg="var(--sand)" />
  <section class="section section--deep isr-band">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Infant Swimming Resource (ISR)</span>
        <h2>Teaching babies to save themselves.</h2>
        <p class="lede">{isr.blurb}</p>
        <ul class="isr-points">
          <li><strong>6–12 months:</strong> roll onto their back, float and breathe</li>
          <li><strong>1–6 years:</strong> swim, roll over to float and rest, then swim again</li>
          <li><strong>One-on-one,</strong> about 10 minutes a day with a certified instructor</li>
        </ul>
        {
          isr.stance && (
            <p class="isr-stance">
              {isr.stance}{' '}
              <a href={url('/swim-lessons#why-we-recommend-isr-not-just-swim-lessons')}>Why we recommend ISR</a>
            </p>
          )
        }
        <div class="btn-row">
          <a class="btn" href={url('/swim-lessons')}>About ISR lessons</a>
          <a class="btn btn--ghost" href={url('/swim-lessons#find')}>Find an instructor near you</a>
        </div>
      </div>
      <div class="isr-side">
      <div class="isr-card reveal">
        <p class="isr-card__label">Why this is personal</p>
        <p class="isr-card__name">Adam’s nearest ISR instructor was two hours away.</p>
        <p>After Adam drowned, our dad became one. Wherever you live, ISR’s map lists every certified instructor near you.</p>
        <p class="isr-card__quote">“Skills before thrills. Sometimes there are no do-overs.”</p>
      </div>
      <div class="isr-peds reveal">
        <PediatriciansSay level={3} />
      </div>
      </div>
    </div>
  </section>
  <Wave color="var(--foam)" bg="var(--deep)" />

  <!-- SURVIVORS -->
  <section class="section section--foam" style="padding-top: clamp(32px, 5vw, 64px)">
    <div class="wrap split split--wide-left">
      <div class="reveal">
        <span class="eyebrow">Survivors & families</span>
        <h2>Surviving is only the beginning.</h2>
        <p class="lede">
          For every child lost to drowning, seven more survive one. Some, like Adam, come home with injuries that
          change everything, and families who need a village around them. We want every one of them to know
          they’re not alone.
        </p>
        <div class="btn-row">
          <a class="btn btn--ocean" href={url('/survivors-and-families')}>Support for families</a>
        </div>
      </div>
      {
        survivorStat && (
          <div class="survivor-stat card reveal">
            <p class="stat__num">{survivorStat.stat}</p>
            <p>{survivorStat.label}</p>
            <a class="source" href={survivorStat.sourceUrl} rel="noopener" target="_blank">
              Source: {survivorStat.source}
              <span class="visually-hidden"> for “{survivorStat.stat}” (opens in a new tab)</span>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- EVENTS -->
  {
    homeEvents.length > 0 && (
      <section class="section">
        <div class="wrap">
          <span class="eyebrow">Events & fundraisers</span>
          <h2>Come find Adam’s village.</h2>
          <p class="lede">Every event brings Adam’s village together and puts water safety in front of families who need it.</p>
          <div class="grid grid--3" style="margin-top: 32px">
            {homeEvents.map((e) => <EventCard event={e} />)}
          </div>
          <div class="btn-row">
            <a class="btn btn--ocean" href={url('/events')}>All our events</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- FACEBOOK -->
  {
    site.showFacebookFeed && (
      <section class="section section--foam">
        <div class="wrap split fb-split">
          <div class="reveal">
            <span class="eyebrow">Follow along</span>
            <h2>Adam’s Village of Hope</h2>
            <p class="lede">
              Thousands of people follow Adam’s journey on Facebook. It’s where we share his milestones, our events, and
              water safety reminders all year long.
            </p>
            <div class="btn-row">
              <a class="btn btn--ocean" href={site.facebookUrl} rel="noopener" target="_blank">Follow us on Facebook</a>
            </div>
          </div>
          <FacebookFeed maxHeight={860} />
        </div>
      </section>
    )
  }

  <!-- PLEDGE -->
  <CtaBand
    title="Be the Water Watcher."
    text="When everyone is watching, no one is. Promise to name one adult whose only job is to watch the water, and print your Water Watcher card."
  >
    <a class="btn" href={url('/water-watcher')}>Take the pledge</a>
    <a class="btn btn--ghost" href={url('/get-involved')}>More ways to help</a>
  </CtaBand>

  <!-- GET INVOLVED -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Join the movement</span>
      <h2>Adam’s village is growing.</h2>
      <div class="grid grid--3" style="margin-top: 32px">
        {
          hasDonate ? (
            <a class="card join reveal" href={url('/donate')}>
              <h3>Give</h3>
              <p>Help put Water Watcher tags, alarms, CPR and water safety education within reach of more families.</p>
              <span class="join__go">Donate →</span>
            </a>
          ) : (
            <a class="card join reveal" href={url('/water-watcher')}>
              <h3>Pledge</h3>
              <p>Promise to be a Water Watcher, print your card, and ask your family to do the same.</p>
              <span class="join__go">Take the pledge →</span>
            </a>
          )
        }
        <a class="card join reveal" href={url('/get-involved')}>
          <h3>Share</h3>
          <p>Ready-to-post messages that put water safety in front of the people you love.</p>
          <span class="join__go">Get the toolkit →</span>
        </a>
        <a class="card join reveal" href={url('/request-a-talk')}>
          <h3>Invite us</h3>
          <p>Schools, daycares, churches and community groups: we’ll share Adam’s story and the layers of protection.</p>
          <span class="join__go">Request a talk →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    background:
      radial-gradient(50% 45% at 85% -5%, rgb(255 214 120 / 0.55) 0%, transparent 70%),
      radial-gradient(120% 70% at 70% -10%, #3fb3c4 0%, transparent 60%),
      linear-gradient(180deg, var(--ocean-bright) 0%, var(--ocean) 48%, var(--deep) 100%);
  }
  .hero__caustics {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(12% 8% at 20% 20%, rgb(255 255 255 / 0.3), transparent 70%),
      radial-gradient(10% 6% at 60% 12%, rgb(255 244 214 / 0.35), transparent 70%),
      radial-gradient(14% 9% at 85% 30%, rgb(255 255 255 / 0.22), transparent 70%),
      radial-gradient(9% 7% at 40% 38%, rgb(255 255 255 / 0.18), transparent 70%),
      conic-gradient(from 200deg at 80% -20%, transparent 0 40%, rgb(255 244 214 / 0.16) 45%, transparent 50% 60%, rgb(255 255 255 / 0.12) 64%, transparent 70%);
    filter: blur(8px);
    animation: caustics 16s ease-in-out infinite alternate;
  }
  @keyframes caustics {
    to {
      transform: translate3d(4%, 3%, 0) rotate(3deg) scale(1.08);
    }
  }
  .hero__bubbles span {
    position: absolute;
    bottom: -20px;
    left: calc(var(--i) * 7.3%);
    width: calc(4px + (var(--i) * 7 % 9) * 1px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(255 255 255 / 0.08);
    animation: rise calc(10s + var(--i) * 1.3s) linear infinite;
    animation-delay: calc(var(--i) * -1.7s);
  }
  @keyframes rise {
    to {
      transform: translate3d(calc(sin(var(--i)) * 30px), -110vh, 0);
      opacity: 0;
    }
  }
  .hero__inner {
    position: relative;
    padding-top: clamp(80px, 14vh, 160px);
    padding-bottom: clamp(24px, 6vh, 64px);
  }
  /* On phones, don't make people scroll past empty sky to reach the words. */
  @media (max-width: 640px) {
    .hero {
      min-height: auto;
    }
    .hero__inner {
      padding-top: 56px;
    }
  }
  .hero__eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.5rem;
  }
  /* White, not gold: the moving light in the hero can sit right behind this label on phones. */
  .hero__eyebrow strong {
    color: #fff;
    font-weight: 800;
  }
  .hero__title {
    font-size: clamp(3rem, 8.4vw + 0.5rem, 7.6rem);
    text-shadow: 0 2px 30px rgb(4 29 43 / 0.35);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 0.35em;
  }
  .hero__line {
    display: block;
    animation: surface 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__line--2 {
    font-style: italic;
    color: var(--sun);
    animation-delay: 0.6s;
  }
  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(8px);
    }
  }
  .hero__lede {
    font-size: clamp(1.15rem, 0.8vw + 1rem, 1.5rem);
    max-width: 44ch;
    color: var(--on-dark);
    animation: surface 1.4s 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__lede strong {
    color: var(--sun);
  }
  .hero .btn-row {
    animation: surface 1.4s 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* ---------- Stats ---------- */
  .stat__num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 4vw + 1rem, 4.6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ocean);
    margin-bottom: 12px;
  }

  /* ---------- Clock ---------- */
  .clock-section {
    padding-block: clamp(56px, 9vw, 112px);
  }

  /* ---------- Layers ---------- */
  .layers-intro {
    max-width: 760px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .layers-lede {
    max-width: 62ch;
    margin-bottom: 2rem;
  }
  .tonight {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .tonight p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .tonight__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--foam);
    color: var(--ocean);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .missing-callout {
    margin-top: 28px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--deep);
    color: var(--on-dark);
    border-left: 8px solid var(--sun);
  }
  .missing-callout h3 {
    color: var(--sun);
    margin-bottom: 0.3em;
  }
  .missing-callout a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--shallow);
    font-weight: 700;
  }

  /* ---------- Survivors ---------- */
  .survivor-stat .stat__num {
    font-size: clamp(3.5rem, 6vw, 5.5rem);
  }

  /* ---------- ISR ---------- */
  .isr-band {
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .isr-points {
    padding-left: 1.2em;
    margin: 0 0 8px;
    display: grid;
    gap: 6px;
  }
  .isr-stance {
    margin-top: 1.25rem;
    padding-left: 14px;
    border-left: 3px solid var(--sun);
    color: var(--on-dark);
    font-weight: 600;
    max-width: 52ch;
  }
  .isr-side {
    display: grid;
    gap: 24px;
  }
  .isr-card {
    background:
      radial-gradient(50% 60% at 100% 100%, rgb(255 214 120 / 0.18), transparent 70%),
      linear-gradient(340deg, var(--ocean-bright), var(--ocean));
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 44px);
    color: #fff;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .isr-card__label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sun-text);
    margin-bottom: 6px;
  }
  .isr-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2vw + 1rem, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
  }
  .isr-card__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    margin: 1.2em 0 0;
    padding-top: 1em;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }
  .fb-split {
    align-items: start;
  }
  .fb-split :global(.fb-feed) {
    justify-self: center;
  }
  /* Give the feed the bigger side on wide screens so it can scale up. */
  @media (min-width: 900px) {
    .fb-split {
      grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    }
    .fb-split > :first-child {
      position: sticky;
      top: 110px;
    }
  }

  /* ---------- Join ---------- */
  .join {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .join:hover {
    color: var(--ink);
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -20px rgb(4 29 43 / 0.45);
  }
  .join__go {
    margin-top: auto;
    font-weight: 700;
    color: var(--ocean);
  }
</style>
